<script>
// Simulate viewer count changes
(function() {
  const viewerCount = document.getElementById('product-viewer-count');
  if (!viewerCount) return;
  
  setInterval(function() {
    const currentCount = parseInt(viewerCount.textContent);
    const change = Math.random() > 0.5 ? 1 : -1;
    const newCount = Math.max(8, Math.min(45, currentCount + change));
    viewerCount.textContent = newCount;
  }, 5000);
})();

// Thumbnail click handler and Full-screen Modal - wrapped in DOMContentLoaded for reliability
(function() {
  function initializeProductThumbnails() {
    const thumbnails = document.querySelectorAll('.product-single__thumbnail');
    const mainImg = document.getElementById('ProductPhotoImg');
    const modal = document.getElementById('productImageModal');
    const modalCloseBtn = document.getElementById('modalCloseBtn');
    const modalMainImage = document.getElementById('modalMainImage');
    const modalThumbnails = document.querySelectorAll('.modal-thumbnail');
    
    if (!thumbnails.length || !mainImg) {
      console.warn('Product thumbnails or main image not found');
      return;
    }
    
    // Set first thumbnail as active
    if (thumbnails[0]) {
      thumbnails[0].classList.add('active');
    }
    
    // Open modal when clicking main image
    function openModal() {
      if (!modal) return;
      modal.classList.add('active');
      modalMainImage.src = mainImg.src;
      document.body.style.overflow = 'hidden';
      
      // Set active state on modal thumbnails
      if (modalThumbnails.length > 0) {
        const currentSrc = mainImg.src;
        modalThumbnails.forEach(function(thumb) {
          const thumbImg = thumb.querySelector('img');
          if (thumbImg && thumbImg.dataset.largeSrc === currentSrc) {
            thumb.classList.add('active');
          } else {
            thumb.classList.remove('active');
          }
        });
      }
    }
    
    // Close modal
    function closeModal() {
      if (!modal) return;
      modal.classList.remove('active');
      document.body.style.overflow = '';
    }
    
    // Main image click to open modal
    mainImg.addEventListener('click', openModal);
    mainImg.style.cursor = 'zoom-in';
    
    // Close button
    if (modalCloseBtn) {
      modalCloseBtn.addEventListener('click', closeModal);
    }
    
    // Close on backdrop click
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          closeModal();
        }
      });
    }
    
    // Close on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        closeModal();
      }
    });
    
    // Modal thumbnails click handler
    modalThumbnails.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        const thumbImg = this.querySelector('img');
        if (!thumbImg) return;
        
        const largeSrc = thumbImg.dataset.largeSrc || thumbImg.src;
        if (largeSrc && modalMainImage) {
          modalMainImage.src = largeSrc;
          
          // Update active state
          modalThumbnails.forEach(function(t) {
            t.classList.remove('active');
          });
          this.classList.add('active');
        }
      });
    });
    
    // Product page thumbnails click handler
    thumbnails.forEach(function(thumb, index) {
      thumb.addEventListener('click', function() {
        const thumbImg = this.querySelector('img');
        if (!thumbImg) {
          console.warn('Thumbnail image not found at index:', index);
          return;
        }
        
        const largeSrc = thumbImg.dataset.largeSrc || thumbImg.src;
        if (largeSrc) {
          mainImg.src = largeSrc;
          
          // Update active state using class for better maintainability
          thumbnails.forEach(function(t) {
            t.classList.remove('active');
          });
          this.classList.add('active');
        }
      });
      
      // Add hover effect
      thumb.addEventListener('mouseenter', function() {
        if (!this.classList.contains('active')) {
          this.classList.add('thumbnail-hover');
        }
      });
      
      thumb.addEventListener('mouseleave', function() {
        this.classList.remove('thumbnail-hover');
      });
    });
    
    if (typeof console !== 'undefined' && console.log) {
      console.log('Product thumbnails initialized:', thumbnails.length);
    }
  }
  
  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeProductThumbnails);
  } else {
    initializeProductThumbnails();
  }
})();
</script>
