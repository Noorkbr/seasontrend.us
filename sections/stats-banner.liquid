{% comment %}
  Premium Stats Banner
  ====================
  Animated statistics section showing social proof numbers.
  Numbers animate on scroll into view.
  
  To edit: Theme Editor > Home page > Stats Banner
{% endcomment %}

<section class="premium-stats-banner">
  <div class="stats-background">
    <div class="aurora-blob aurora-blob-1"></div>
    <div class="aurora-blob aurora-blob-2"></div>
  </div>
  
  <div class="container">
    <div class="stats-grid">
      {% for block in section.blocks %}
        <div class="stat-item" {{ block.shopify_attributes }}>
          <div class="stat-number" data-target="{{ block.settings.number }}">
            {{ block.settings.number }}{{ block.settings.suffix }}
          </div>
          <div class="stat-label">{{ block.settings.label }}</div>
        </div>
      {% endfor %}
      
      {% if section.blocks.size == 0 %}
        <div class="stat-item">
          <div class="stat-number">50K+</div>
          <div class="stat-label">Happy Customers</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">4.9</div>
          <div class="stat-label">Star Rating</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">100K+</div>
          <div class="stat-label">Products Sold</div>
        </div>
        <div class="stat-item">
          <div class="stat-number">24/7</div>
          <div class="stat-label">Customer Support</div>
        </div>
      {% endif %}
    </div>
    
    {% if section.settings.show_cta %}
      <div class="stats-cta">
        <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="glass-pill-btn">
          {{ section.settings.cta_text | default: 'Join Thousands of Happy Customers' }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
.premium-stats-banner {
  background: var(--arctic-void, #05080F);
  padding: clamp(4rem, 10vw, 6rem) 2rem;
  position: relative;
  overflow: hidden;
}

.stats-background {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.aurora-blob {
  position: absolute;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.3;
  will-change: transform;
  transform: translate3d(0, 0, 0);
  animation: float 10s ease-in-out infinite;
}

.aurora-blob-1 {
  background: var(--arctic-aurora-cyan, #00F2FF);
  top: -20%;
  left: -10%;
  animation-delay: 0s;
}

.aurora-blob-2 {
  background: var(--arctic-aurora-purple, #BD00FF);
  bottom: -20%;
  right: -10%;
  animation-delay: 5s;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(30px, -30px) scale(1.1); }
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  max-width: 1200px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.stat-item {
  text-align: center;
  padding: 2rem 1rem;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 1.5rem;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition: all 0.4s ease;
}

.stat-item:hover {
  transform: translateY(-5px);
  border-color: rgba(0, 242, 255, 0.3);
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2), 0 0 40px rgba(0, 242, 255, 0.1);
}

.stat-number {
  font-family: var(--font-clash, 'Inter', sans-serif);
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 800;
  background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  line-height: 1.1;
  margin-bottom: 0.5rem;
}

.stat-label {
  font-family: var(--font-satoshi, 'Inter', sans-serif);
  font-size: 1rem;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.7);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.stats-cta {
  text-align: center;
  margin-top: 3rem;
  position: relative;
  z-index: 1;
}

@media (max-width: 1024px) {
  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .stats-grid {
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  
  .stat-item {
    padding: 1.5rem 1rem;
  }
  
  .stat-number {
    font-size: 2rem;
  }
  
  .stat-label {
    font-size: 0.8125rem;
  }
}
</style>

{% schema %}
{
  "name": "Stats Banner",
  "tag": "section",
  "class": "stats-banner-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA Button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Join Thousands of Happy Customers"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "50K"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix (e.g., +, %)",
          "default": "+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Happy Customers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stats Banner",
      "category": "Arctic Neo-Luxury",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "number": "50K",
            "suffix": "+",
            "label": "Happy Customers"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "4.9",
            "suffix": "",
            "label": "Star Rating"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "100K",
            "suffix": "+",
            "label": "Products Sold"
          }
        },
        {
          "type": "stat",
          "settings": {
            "number": "24/7",
            "suffix": "",
            "label": "Customer Support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
