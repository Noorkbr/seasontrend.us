<section class="product-grid-section" id="holographic-grid">
  <div class="container">
    {% if section.settings.grid_title %}
      <h2 style="font-family: var(--font-clash); font-size: clamp(2rem, 6vw, 4rem); font-weight: 800; text-align: center; color: white; margin-bottom: 4rem; letter-spacing: -0.02em;">
        {{ section.settings.grid_title }}
      </h2>
    {% endif %}
    
    <div class="holographic-grid">
      {% assign products = section.settings.product_list | default: section.settings.collection.products %}
      
      {% if products != blank %}
        {% for product in products limit: section.settings.products_to_show %}
          <div class="glass-product-card">
            <div class="product-image-container">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 600 }}" 
                       alt="{{ product.title | escape }}"
                       width="600"
                       height="600">
                {% else %}
                  <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%); opacity: 0.3;"></div>
                {% endif %}
              </a>
            </div>
            
            <h3 class="product-title"><a href="{{ product.url }}" style="color: inherit; text-decoration: none;">{{ product.title }}</a></h3>
            
            <div class="product-price">
              {{ product.price | money }}
              {% if product.compare_at_price > product.price %}
                <span style="font-size: 1rem; text-decoration: line-through; opacity: 0.5; margin-left: 0.5rem;">
                  {{ product.compare_at_price | money }}
                </span>
              {% endif %}
            </div>
            
            <form method="post" action="/cart/add">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="quick-buy-btn">Add to Cart</button>
            </form>
          </div>
        {% endfor %}
      {% else %}
        {% for i in (1..4) %}
          <div class="glass-product-card">
            <div class="product-image-container">
              <div style="width: 100%; height: 100%; background: linear-gradient(135deg, rgba(0, 242, 255, 0.2) 0%, rgba(189, 0, 255, 0.2) 100%); display: flex; align-items: center; justify-content: center;">
                <span style="font-size: 2rem;">🛍️</span>
              </div>
            </div>
            <h3 class="product-title">Example Product {{ i }}</h3>
            <div class="product-price">$99.00</div>
            <button class="quick-buy-btn">Quick Buy</button>
          </div>
        {% endfor %}
      {% endif %}
    </div>
    
    {% if section.settings.view_all_link %}
      <div style="text-align: center; margin-top: 4rem;">
        <a href="{{ section.settings.view_all_link }}" class="glass-pill-btn">
          {{ section.settings.view_all_text | default: "View All Products" }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Holographic Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "grid_title",
      "label": "Section Title",
      "default": "Featured Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Manual Product Selection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of Products",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "Button Text",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Holographic Product Grid",
      "category": "Arctic Neo-Luxury"
    }
  ]
}
{% endschema %}