<!-- Newsletter Section -->
<section class="newsletter">
  <div class="container">
    <div class="newsletter-content">
      <div class="newsletter-text">
        <h2 class="newsletter-title">{{ section.settings.title | default: "Join Our Newsletter" }}</h2>
        <p class="newsletter-description">
          {{ section.settings.description | default: "Get 15% off your first order when you sign up for our newsletter" }}
        </p>
      </div>
      <div class="newsletter-form">
        {% form 'customer' %}
          {% if form.posted_successfully? %}
            <div class="newsletter-success">
              {{ section.settings.success_message | default: "Thanks for subscribing!" }}
            </div>
          {% endif %}
          
          {% if form.errors %}
            <div class="newsletter-error">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="form-group">
            <input type="email" 
                   name="contact[email]" 
                   id="NewsletterEmail"
                   placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
                   class="newsletter-input"
                   required>
            <button type="submit" class="btn btn-primary">
              {{ section.settings.button_text | default: "Subscribe" }}
            </button>
          </div>
        {% endform %}
        
        {% comment %} Alternative: Klaviyo or Mailchimp form {% endcomment %}
        {% if section.settings.use_custom_form %}
          <form action="{{ section.settings.form_action }}" method="post" class="newsletter-form-custom">
            <div class="form-group">
              <input type="email" 
                     name="email" 
                     placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
                     class="newsletter-input"
                     required>
              <button type="submit" class="btn btn-primary">
                {{ section.settings.button_text | default: "Subscribe" }}
              </button>
            </div>
          </form>
        {% endif %}
        
        <p class="newsletter-disclaimer">
          {{ section.settings.disclaimer | default: "By subscribing, you agree to our Privacy Policy and consent to receive updates from our company." }}
        </p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Join Our Newsletter"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Get 15% off your first order when you sign up for our newsletter"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "By subscribing, you agree to our Privacy Policy and consent to receive updates from our company."
    },
    {
      "type": "checkbox",
      "id": "use_custom_form",
      "label": "Use Custom Form (Mailchimp/Klaviyo)",
      "default": false
    },
    {
      "type": "text",
      "id": "form_action",
      "label": "Custom Form Action URL",
      "info": "For Mailchimp or Klaviyo integration"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
