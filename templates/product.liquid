{% comment %}
  Product Template - Arctic Neo-Luxury Edition
  ============================================
  Premium glassmorphism design with urgency elements,
  viewer counts, and conversion boosters.
{% endcomment %}

<div class="product-template arctic-product">
  <div class="container">
    <!-- Urgency Bar -->
    <div class="product-urgency-bar">
      <span class="urgency-fire">🔥</span>
      <span class="urgency-message">HIGH DEMAND - <span id="product-viewer-count">{{ product.id | modulo: 20 | plus: 15 }}</span> people are viewing this right now</span>
      <span class="urgency-badge-live">LIVE</span>
    </div>

    <div class="product-single">
      <div class="product-single__photos">
        {% if product.images.size > 0 %}
          <div class="product-single__photo glass-panel">
            {% if product.compare_at_price_max > product.price %}
              <div class="product-badge-sale">
                {% assign savings = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max %}
                -{{ savings }}% OFF
              </div>
            {% endif %}
            <img src="{{ product.featured_image | image_url: width: 1000 }}" 
                 alt="{{ product.featured_image.alt | default: product.title | escape }}"
                 id="ProductPhotoImg"
                 onerror="this.onerror=null; this.parentElement.innerHTML='<div style=\'width:100%;height:100%;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);display:flex;align-items:center;justify-content:center;\'><span style=\'font-size:60px;\'>📦</span></div>';">
          </div>
          
          {% if product.images.size > 1 %}
            <div class="product-single__thumbnails">
              {% for image in product.images %}
                <div class="product-single__thumbnail {% if forloop.first %}active{% endif %}" data-thumbnail-index="{{ forloop.index0 }}">
                  {% if image != blank %}
                    <img 
                      src="{{ image | image_url: width: 200 }}" 
                      srcset="{{ image | image_url: width: 100 }} 100w,
                              {{ image | image_url: width: 200 }} 200w,
                              {{ image | image_url: width: 300 }} 300w"
                      sizes="(max-width: 768px) 60px, 80px"
                      alt="{{ image.alt | default: product.title | escape }}"
                      data-large-src="{{ image | image_url: width: 1000 }}"
                      width="80"
                      height="80"
                      loading="lazy"
                      onerror="this.onerror=null; this.parentElement.innerHTML='<div style=\'width:100%;height:100%;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);display:flex;align-items:center;justify-content:center;\'><span style=\'font-size:30px;\'>📷</span></div>';">
                  {% else %}
                    <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
                      <span style="font-size: 30px;">📷</span>
                    </div>
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}
      </div>

      <div class="product-single__info">
        <h1 class="product-single__title">{{ product.title }}</h1>
        
        <!-- Star Rating -->
        <div class="product-rating">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <span class="rating-count">({{ product.id | modulo: 500 | plus: 127 }} reviews)</span>
        </div>
        
        {% if settings.product_show_vendor %}
          <p class="product-single__vendor">By {{ product.vendor }}</p>
        {% endif %}
        
        <div class="product-single__prices">
          {% if product.compare_at_price_max > product.price %}
            <span class="product-single__price product-single__price--sale">
              {{ product.price | money }}
            </span>
            <span class="product-single__price product-single__price--compare">
              {{ product.compare_at_price | money }}
            </span>
            <span class="savings-badge">
              You Save {{ product.compare_at_price | minus: product.price | money }}!
            </span>
          {% else %}
            <span class="product-single__price">
              {{ product.price | money }}
            </span>
          {% endif %}
        </div>

        <!-- Stock Urgency -->
        <div class="stock-urgency">
          <span class="stock-icon">⚡</span>
          <span class="stock-text">Only <strong>{{ product.id | modulo: 8 | plus: 3 }}</strong> left in stock - order soon!</span>
        </div>

        {% if settings.product_show_sku %}
          <p class="product-single__sku">SKU: {{ product.selected_or_first_available_variant.sku }}</p>
        {% endif %}

        <div class="product-single__description glass-panel-subtle">
          {{ product.description }}
        </div>

        <form method="post" action="/cart/add" id="AddToCartForm" class="product-form" data-add-to-cart-form>
          {% if product.variants.size > 1 %}
            <div class="variant-selector">
              <label for="productSelect">Select Option</label>
              <select name="id" id="productSelect" class="product-form__variants">
                {% for variant in product.variants %}
                  <option 
                    {% if variant == product.selected_or_first_available_variant %} selected="selected" {% endif %}
                    {% unless variant.available %} disabled="disabled" {% endunless %}
                    value="{{ variant.id }}">
                    {{ variant.title }} - {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {% endif %}

          <div class="product-form__item product-form__item--quantity">
            <label for="Quantity">{{ 'products.product.quantity' | t }}</label>
            <div class="quantity-selector">
              <button type="button" class="quantity-btn" aria-label="Decrease quantity" onclick="this.nextElementSibling.stepDown(); this.nextElementSibling.dispatchEvent(new Event('change'));">−</button>
              <input type="number" id="Quantity" name="quantity" value="1" min="1" aria-label="Product quantity" class="product-form__input">
              <button type="button" class="quantity-btn" aria-label="Increase quantity" onclick="this.previousElementSibling.stepUp(); this.previousElementSibling.dispatchEvent(new Event('change'));">+</button>
            </div>
          </div>

          <div class="product-form__item product-form__item--submit">
            <button type="submit" name="add" id="AddToCart" class="luxury-cta-primary product-form__cart-submit" data-add-to-cart data-variant-id="{{ product.selected_or_first_available_variant.id }}">
              <span class="btn-icon">🛒</span>
              <span id="AddToCartText">{{ 'products.product.add_to_cart' | t }}</span>
            </button>
          </div>
          
          <!-- Quick Add Button - adds to cart with visual feedback -->
          <button type="button" class="buy-now-btn" onclick="window.location.href='/cart';" aria-label="Go to cart">
            <span>🛒 View Cart</span>
          </button>
        </form>

        <!-- Trust Cards -->
        <div class="product-trust-cards">
          <div class="trust-card">
            <span class="trust-icon">🚚</span>
            <div class="trust-content">
              <strong>Free Shipping</strong>
              <span>Orders over $50</span>
            </div>
          </div>
          <div class="trust-card">
            <span class="trust-icon">🔒</span>
            <div class="trust-content">
              <strong>Secure Checkout</strong>
              <span>SSL Encrypted</span>
            </div>
          </div>
          <div class="trust-card">
            <span class="trust-icon">↩️</span>
            <div class="trust-content">
              <strong>30-Day Returns</strong>
              <span>Money Back Guarantee</span>
            </div>
          </div>
          <div class="trust-card">
            <span class="trust-icon">⭐</span>
            <div class="trust-content">
              <strong>Premium Quality</strong>
              <span>100% Authentic</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Full-screen Image Modal -->
<div class="product-image-modal" id="productImageModal">
  <button class="modal-close-btn" id="modalCloseBtn" aria-label="Close image modal">×</button>
  <div class="modal-image-container">
    <img src="" alt="Product image" id="modalMainImage">
  </div>
  {% if product.images.size > 1 %}
    <div class="modal-thumbnails">
      {% for image in product.images %}
        <div class="modal-thumbnail {% if forloop.first %}active{% endif %}" data-modal-index="{{ forloop.index0 }}">
          <img src="{{ image | image_url: width: 200 }}" 
               alt="{{ image.alt | default: product.title | escape }}"
               data-large-src="{{ image | image_url: width: 1200 }}">
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<style>
/* Arctic Product Template */
.arctic-product {
  background: var(--arctic-void, #05080F);
  padding: 60px 0;
  min-height: 80vh;
}

/* Urgency Bar */
.product-urgency-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 14px 24px;
  background: linear-gradient(90deg, rgba(255, 107, 107, 0.15), rgba(189, 0, 255, 0.15), rgba(0, 242, 255, 0.15));
  border: 1px solid rgba(255, 107, 107, 0.3);
  border-radius: 16px;
  margin-bottom: 40px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.urgency-fire {
  font-size: 20px;
  animation: flame 0.5s ease-in-out infinite alternate;
}

@keyframes flame {
  from { transform: scale(1); }
  to { transform: scale(1.1); }
}

.urgency-message {
  color: rgba(255, 255, 255, 0.9);
  font-size: 14px;
  font-weight: 500;
}

.urgency-message strong {
  color: #00F2FF;
}

.urgency-badge-live {
  background: #FF6B6B;
  color: white;
  padding: 4px 12px;
  border-radius: 50px;
  font-size: 11px;
  font-weight: 700;
  animation: live-pulse 1s ease-in-out infinite;
}

@keyframes live-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* Glass Panel */
.glass-panel {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  overflow: hidden;
}

.glass-panel-subtle {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 24px;
}

.product-single {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 20px;
}

.product-single__photo {
  position: relative;
}

.product-badge-sale {
  position: absolute;
  top: 16px;
  left: 16px;
  background: linear-gradient(135deg, #FF6B6B, #FF8787);
  color: white;
  padding: 8px 16px;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 700;
  z-index: 10;
  box-shadow: 0 4px 15px rgba(255, 107, 107, 0.4);
}

.product-single__photo img {
  width: 100%;
  height: auto;
  border-radius: 20px;
  display: block;
}

.product-single__thumbnails {
  /* Force visibility with !important to override any conflicting CSS that may hide thumbnails */
  display: flex !important;
  gap: 12px;
  margin-top: 16px;
  overflow-x: auto;
  padding-bottom: 8px;
  visibility: visible !important;
  opacity: 1 !important;
  height: auto !important;
  pointer-events: auto !important;
  z-index: 1 !important;
}

.product-single__thumbnail {
  width: 80px;
  height: 80px;
  flex-shrink: 0;
  cursor: pointer;
  border: 2px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
  /* Ensure thumbnail containers are always visible */
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  position: relative;
  z-index: 2;
}

.product-single__thumbnail:hover,
.product-single__thumbnail.thumbnail-hover {
  border-color: rgba(0, 242, 255, 0.5);
  box-shadow: 0 0 20px rgba(0, 242, 255, 0.3);
  transform: translateY(-2px);
}

.thumbnail.active,
.product-single__thumbnail.active {
  border-color: rgba(0, 242, 255, 0.5) !important;
  box-shadow: 0 0 20px rgba(0, 242, 255, 0.3);
}

.product-single__thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  /* Ensure thumbnail images are always visible */
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}

.product-single__title {
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 700;
  margin-bottom: 12px;
  color: white;
  font-family: 'Playfair Display', serif;
}

/* Star Rating */
.product-rating {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 16px;
}

.stars {
  font-size: 16px;
  letter-spacing: 2px;
}

.rating-count {
  color: rgba(255, 255, 255, 0.6);
  font-size: 14px;
}

.product-single__vendor {
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 20px;
  font-size: 14px;
}

.product-single__prices {
  margin: 20px 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
}

.product-single__price {
  font-size: 36px;
  font-weight: 700;
}

.product-single__price--sale {
  background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.product-single__price--compare {
  text-decoration: line-through;
  color: rgba(255, 255, 255, 0.4);
  font-size: 24px;
  font-weight: 400;
}

.savings-badge {
  background: rgba(16, 185, 129, 0.2);
  border: 1px solid rgba(16, 185, 129, 0.4);
  color: #10b981;
  padding: 6px 14px;
  border-radius: 50px;
  font-size: 13px;
  font-weight: 600;
}

/* Stock Urgency */
.stock-urgency {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px 20px;
  background: rgba(255, 107, 107, 0.1);
  border: 1px solid rgba(255, 107, 107, 0.3);
  border-radius: 12px;
  margin-bottom: 20px;
}

.stock-icon {
  font-size: 20px;
}

.stock-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 14px;
}

.stock-text strong {
  color: #FF6B6B;
}

.product-single__sku {
  color: rgba(255, 255, 255, 0.5);
  font-size: 12px;
  margin-bottom: 20px;
}

.product-single__description {
  margin: 24px 0;
  line-height: 1.8;
  color: rgba(255, 255, 255, 0.8);
  font-size: 15px;
}

/* Form Styles */
.product-form {
  margin-bottom: 32px;
}

.variant-selector {
  margin-bottom: 20px;
}

.variant-selector label {
  display: block;
  color: white;
  font-weight: 600;
  margin-bottom: 10px;
  font-size: 14px;
}

.product-form__variants {
  width: 100%;
  padding: 14px 16px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  font-size: 16px;
  background: rgba(255, 255, 255, 0.05);
  color: white;
  cursor: pointer;
  transition: all 0.3s ease;
}

.product-form__variants:focus {
  outline: none;
  border-color: rgba(0, 242, 255, 0.5);
  box-shadow: 0 0 20px rgba(0, 242, 255, 0.2);
}

.product-form__variants option {
  background: #05080F;
  color: white;
}

.product-form__item {
  margin-bottom: 20px;
}

.product-form__item label {
  display: block;
  color: white;
  font-weight: 600;
  margin-bottom: 10px;
  font-size: 14px;
}

.quantity-selector {
  display: flex;
  align-items: center;
  gap: 0;
  max-width: 160px;
}

.quantity-btn {
  width: 48px;
  height: 48px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: white;
  font-size: 20px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.quantity-btn:first-child {
  border-radius: 12px 0 0 12px;
  border-right: none;
}

.quantity-btn:last-child {
  border-radius: 0 12px 12px 0;
  border-left: none;
}

.quantity-btn:hover {
  background: rgba(0, 242, 255, 0.2);
  border-color: rgba(0, 242, 255, 0.4);
}

.product-form__input {
  width: 64px;
  padding: 12px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 0;
  font-size: 16px;
  text-align: center;
  background: rgba(255, 255, 255, 0.05);
  color: white;
}

.product-form__cart-submit {
  width: 100%;
  min-height: 56px;
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 10px;
  font-size: 16px;
}

.btn-icon {
  font-size: 20px;
}

/* Buy Now Button */
.buy-now-btn {
  width: 100%;
  padding: 16px 24px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 50px;
  color: white;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  margin-top: 12px;
}

.buy-now-btn:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(0, 242, 255, 0.4);
  transform: translateY(-2px);
}

/* Trust Cards */
.product-trust-cards {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-top: 32px;
}

.trust-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  transition: all 0.3s ease;
}

.trust-card:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(0, 242, 255, 0.2);
  transform: translateY(-2px);
}

.trust-icon {
  font-size: 24px;
}

.trust-content {
  display: flex;
  flex-direction: column;
}

.trust-content strong {
  color: white;
  font-size: 13px;
  margin-bottom: 2px;
}

.trust-content span {
  color: rgba(255, 255, 255, 0.5);
  font-size: 11px;
}

/* Responsive */
@media (max-width: 1024px) {
  .product-single {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  
  .product-single__photos {
    max-width: 100%;
    width: 100%;
  }
  
  .product-single__photo {
    width: 100%;
  }
  
  .product-single__photo img {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: contain;
  }
}

@media (max-width: 768px) {
  .arctic-product {
    padding: 20px 0;
  }

  .product-urgency-bar {
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    padding: 10px 12px;
    margin-bottom: 20px;
    max-width: 100%;
    margin-left: 10px;
    margin-right: 10px;
  }

  .urgency-message {
    font-size: 12px;
    width: 100%;
    margin-top: 4px;
  }
  
  .urgency-badge-live {
    font-size: 10px;
    padding: 3px 8px;
  }

  .product-single {
    padding: 0 12px;
    gap: 24px;
  }
  
  .product-single__photos {
    width: 100%;
    max-width: 100%;
  }
  
  .product-single__photo {
    border-radius: 16px;
    width: 100%;
  }
  
  .product-single__photo img {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: contain;
    border-radius: 16px;
  }
  
  .product-badge-sale {
    top: 10px;
    left: 10px;
    font-size: 11px;
    padding: 5px 10px;
  }
  
  .product-single__thumbnails {
    display: flex !important;
    gap: 8px;
    margin-top: 12px;
    padding: 8px 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  
  .product-single__thumbnail {
    width: 60px !important;
    height: 60px !important;
    min-width: 60px;
    flex-shrink: 0;
    border-radius: 10px;
  }
  
  .product-single__info {
    width: 100%;
    padding: 0;
  }
  
  .product-single__title {
    font-size: 22px;
    line-height: 1.3;
    margin-bottom: 10px;
  }
  
  .product-rating {
    margin-bottom: 12px;
  }
  
  .stars {
    font-size: 14px;
  }
  
  .rating-count {
    font-size: 12px;
  }

  .product-single__prices {
    flex-direction: column;
    align-items: flex-start;
    margin: 16px 0;
    gap: 8px;
  }

  .product-single__price {
    font-size: 26px;
  }
  
  .product-single__price--compare {
    font-size: 18px;
  }
  
  .savings-badge {
    font-size: 11px;
    padding: 4px 10px;
  }
  
  .stock-urgency {
    padding: 10px 14px;
    margin-bottom: 16px;
  }
  
  .stock-icon {
    font-size: 16px;
  }
  
  .stock-text {
    font-size: 13px;
  }
  
  .product-single__description {
    padding: 16px;
    margin: 16px 0;
    font-size: 14px;
    line-height: 1.7;
  }
  
  .product-form {
    margin-bottom: 24px;
  }
  
  .variant-selector {
    margin-bottom: 16px;
  }
  
  .variant-selector label {
    font-size: 13px;
    margin-bottom: 8px;
  }
  
  .product-form__variants {
    padding: 12px 14px;
    font-size: 14px;
  }
  
  .product-form__item label {
    font-size: 13px;
    margin-bottom: 8px;
  }
  
  .quantity-selector {
    max-width: 140px;
  }
  
  .quantity-btn {
    width: 40px;
    height: 40px;
    font-size: 18px;
  }
  
  .product-form__input {
    width: 56px;
    padding: 10px;
    font-size: 14px;
  }
  
  .product-form__cart-submit {
    min-height: 50px;
    font-size: 14px;
    padding: 12px 20px;
  }
  
  .btn-icon {
    font-size: 18px;
  }
  
  .buy-now-btn {
    padding: 12px 20px;
    font-size: 14px;
  }

  .product-trust-cards {
    grid-template-columns: 1fr;
    gap: 10px;
    margin-top: 24px;
  }
  
  .trust-card {
    padding: 12px;
    gap: 10px;
  }
  
  .trust-icon {
    font-size: 20px;
  }
  
  .trust-content strong {
