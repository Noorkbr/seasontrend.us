{% paginate collection.products by 12 %}
{% comment %}
  Collection Template - Arctic Neo-Luxury Edition
  ===============================================
  Product collection page with premium glassmorphism styling.
  Responsive grid with urgency elements and AJAX add-to-cart.
{% endcomment %}

<div class="collection-template arctic-collection">
  <div class="container">
    <header class="collection-header">
      <h1 class="collection-title">{{ collection.title }}</h1>
      {% if collection.description != blank %}
        <div class="collection-description">
          {{ collection.description }}
        </div>
      {% endif %}
      {% if collection.products_count > 0 %}
        <p class="collection-count">
          <span class="count-highlight">{{ collection.products_count }}</span> {{ collection.products_count | pluralize: 'product', 'products' }} available
        </p>
      {% endif %}
    </header>

    {% if collection.products.size > 0 %}
      <!-- Collection Urgency Banner -->
      <div class="collection-urgency-bar">
        <span class="urgency-icon">🔥</span>
        <span class="urgency-text">Limited stock available - Items selling fast!</span>
      </div>

      <div class="collection-grid holographic-grid">
        {% for product in collection.products %}
          <article class="glass-product-card" data-product-id="{{ product.id }}">
            <!-- Sale Badge -->
            {% if product.compare_at_price_max > product.price %}
              <div class="product-badge product-badge--sale">
                {% assign savings = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max %}
                -{{ savings }}%
              </div>
            {% endif %}
            
            <!-- Hot Badge for first few products -->
            {% if forloop.index <= 3 %}
              <div class="product-badge product-badge--hot">🔥 HOT</div>
            {% endif %}
            
            <a href="{{ product.url }}" class="product-card__link">
              <div class="product-image-container">
                {% if product.featured_image %}
                  <img 
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    srcset="{{ product.featured_image | image_url: width: 200 }} 200w,
                            {{ product.featured_image | image_url: width: 400 }} 400w,
                            {{ product.featured_image | image_url: width: 600 }} 600w"
                    sizes="(max-width: 480px) 45vw, (max-width: 768px) 30vw, 25vw"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="product-image">
                {% else %}
                  <div class="product-image-placeholder">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="M21 15l-5-5L5 21"/>
                    </svg>
                  </div>
                {% endif %}
                
                <!-- Stock indicator -->
                <div class="stock-indicator">
                  Only {{ product.id | modulo: 7 | plus: 2 }} left!
                </div>
              </div>
              
              <div class="product-info">
                <h3 class="product-title">{{ product.title }}</h3>
                
                <!-- Star rating -->
                <div class="product-rating-mini">
                  <span class="stars-mini">⭐⭐⭐⭐⭐</span>
                  <span class="rating-count-mini">({{ product.id | modulo: 200 | plus: 50 }})</span>
                </div>
                
                <div class="product-price">
                  <span class="product-price__current">{{ product.price | money }}</span>
                  {% if product.compare_at_price_max > product.price %}
                    <span class="product-price__compare">{{ product.compare_at_price_max | money }}</span>
                  {% endif %}
                </div>
              </div>
            </a>

            {% if product.available %}
              <form class="product-form" data-add-to-cart-form>
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button 
                  type="submit" 
                  class="quick-buy-btn"
                  data-add-to-cart
                  data-variant-id="{{ product.selected_or_first_available_variant.id }}">
                  <span class="btn-text">{{ 'products.product.add_to_cart' | t | default: 'Add to Cart' }}</span>
                  <span class="btn-loading" aria-hidden="true">
                    <svg class="spinner" viewBox="0 0 24 24" width="20" height="20">
                      <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="32" stroke-linecap="round"/>
                    </svg>
                  </span>
                  <span class="btn-success" aria-hidden="true">✓</span>
                </button>
              </form>
            {% else %}
              <button class="quick-buy-btn quick-buy-btn--sold-out" disabled>
                {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
              </button>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Pagination">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="pagination__item pagination__item--prev" aria-label="Previous page">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
              Previous
            </a>
          {% endif %}
          
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="pagination__item">{{ part.title }}</a>
            {% else %}
              <span class="pagination__item pagination__item--current" aria-current="page">{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="pagination__item pagination__item--next" aria-label="Next page">
              Next
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
            </a>
          {% endif %}
        </nav>
      {% endif %}
    {% else %}
      <div class="collection-empty">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="empty-icon">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
        <p>{{ 'collections.general.no_matches' | t | default: 'No products found in this collection.' }}</p>
        <a href="/collections/all" class="glass-pill-btn collection-cta">
          Browse All Products
        </a>
      </div>
    {% endif %}
  </div>
</div>

{% endpaginate %}

<style>
/* Arctic Collection Styles - Premium Edition */
.arctic-collection {
  background: var(--arctic-void, #05080F);
  min-height: 60vh;
  padding: 4rem 0;
}

.collection-header {
  text-align: center;
  margin-bottom: 3rem;
}

.collection-title {
  font-family: var(--font-clash, 'Playfair Display', serif);
  font-size: clamp(2.5rem, 6vw, 4rem);
  font-weight: 800;
  color: white;
  margin: 0 0 1rem;
  letter-spacing: -0.02em;
}

.collection-description {
  max-width: 700px;
  margin: 0 auto 1rem;
  color: rgba(255, 255, 255, 0.7);
  font-size: 1.125rem;
  line-height: 1.7;
}

.collection-count {
  color: rgba(255, 255, 255, 0.5);
  font-size: 0.875rem;
  margin: 0;
}

.count-highlight {
  background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 700;
  font-size: 1rem;
}

/* Collection Urgency Banner */
.collection-urgency-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 24px;
  background: linear-gradient(90deg, rgba(255, 107, 107, 0.15), rgba(189, 0, 255, 0.15));
  border: 1px solid rgba(255, 107, 107, 0.3);
  border-radius: 12px;
  margin-bottom: 2rem;
  max-width: 500px;
  margin-left: auto;
  margin-right: auto;
}

.collection-urgency-bar .urgency-icon {
  font-size: 18px;
}

.collection-urgency-bar .urgency-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 13px;
  font-weight: 500;
}

/* Collection Grid */
.collection-grid {
  margin-bottom: 4rem;
}

/* Product Badge Enhancements */
.product-badge {
  position: absolute;
  top: 12px;
  z-index: 10;
  padding: 6px 12px;
  border-radius: 50px;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.product-badge--sale {
  left: 12px;
  background: linear-gradient(135deg, #FF6B6B, #FF8787);
  color: white;
  box-shadow: 0 4px 12px rgba(255, 107, 107, 0.4);
}

.product-badge--hot {
  right: 12px;
  background: linear-gradient(135deg, #f59e0b, #d97706);
  color: white;
  box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
  animation: badge-pulse 2s ease-in-out infinite;
}

@keyframes badge-pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* Stock Indicator */
.stock-indicator {
  position: absolute;
  bottom: 12px;
  left: 12px;
  right: 12px;
  padding: 8px 12px;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(10px);
  border-radius: 8px;
  color: #FF6B6B;
  font-size: 11px;
  font-weight: 600;
  text-align: center;
  opacity: 0;
  transform: translateY(10px);
  transition: all 0.3s ease;
}

.glass-product-card:hover .stock-indicator {
  opacity: 1;
  transform: translateY(0);
}

/* Product Rating Mini */
.product-rating-mini {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 8px;
}

.stars-mini {
  font-size: 10px;
  letter-spacing: 1px;
}

.rating-count-mini {
  color: rgba(255, 255, 255, 0.5);
  font-size: 11px;
}

/* Product Price Enhancement */
.product-price__current {
  background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 700;
}

.product-price__compare {
  color: rgba(255, 255, 255, 0.4);
  text-decoration: line-through;
  font-size: 0.875em;
  margin-left: 8px;
}

/* Product Card Link */
.product-card__link {
  text-decoration: none;
  color: inherit;
  display: block;
}

/* Pagination */
.pagination {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;
}

.pagination__item {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.75rem 1.25rem;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 8px;
  color: rgba(255, 255, 255, 0.8);
  text-decoration: none;
  font-size: 0.875rem;
  transition: all 0.3s ease;
}

.pagination__item:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(0, 242, 255, 0.3);
  color: white;
  transform: translateY(-2px);
}

.pagination__item--current {
  background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
  border-color: transparent;
  color: white;
  font-weight: 600;
  box-shadow: 0 4px 15px rgba(0, 242, 255, 0.3);
}

.pagination__item--prev,
.pagination__item--next {
  font-weight: 500;
}

/* Empty State */
.collection-empty {
  text-align: center;
  padding: 4rem 2rem;
  color: rgba(255, 255, 255, 0.6);
}

.collection-empty .empty-icon {
  opacity: 0.3;
  margin-bottom: 1rem;
}

.collection-empty p {
  font-size: 1.25rem;
  margin: 0;
  color: white;
}

.collection-empty .collection-cta {
  margin-top: 1.5rem;
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .arctic-collection {
    padding: 3rem 1rem;
  }
  
  .collection-header {
    margin-bottom: 2rem;
    text-align: left;
  }
  
  .collection-description {
    margin-left: 0;
  }
  
  .pagination {
    gap: 0.25rem;
  }
  
  .pagination__item {
    padding: 0.5rem 0.75rem;
    font-size: 0.8125rem;
  }
}
</style>
