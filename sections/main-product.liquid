<section class="main-product-section" style="padding: 60px 0; background: var(--arctic-void);">
  <div class="container" style="max-width: 1400px; margin: 0 auto; padding: 0 20px;">
    <div class="product-layout" style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start;">
      
      <div class="product-images" style="position: sticky; top: 140px;">
        <div class="main-image" style="background: rgba(255, 255, 255, 0.03); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 24px; overflow: hidden; margin-bottom: 20px; aspect-ratio: 1;">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 1000 }}" 
                 alt="{{ product.featured_image.alt | escape }}"
                 style="width: 100%; height: 100%; object-fit: cover;">
          {% else %}
            <div style="width: 100%; height: 100%; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); display: flex; align-items: center; justify-content: center;">
              <span style="font-size: 80px;">📦</span>
            </div>
          {% endif %}
        </div>
        
        {% if product.images.size > 1 %}
          <div class="thumbnail-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 12px;">
            {% for image in product.images limit: 6 %}
              <div class="thumbnail" style="aspect-ratio: 1; border-radius: 12px; overflow: hidden; cursor: pointer; border: 2px solid rgba(255, 255, 255, 0.1);">
                <img src="{{ image | image_url: width: 200 }}" 
                     alt="{{ image.alt | escape }}"
                     style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="product-info">
        <h1 style="font-family: 'Playfair Display', serif; font-size: 48px; font-weight: 700; color: white; margin-bottom: 16px;">{{ product.title }}</h1>

        <div class="product-price" style="margin-bottom: 32px;">
          <span style="font-family: 'Inter', sans-serif; font-size: 48px; font-weight: 700; background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
            {{ product.price | money }}
          </span>
        </div>

        <div class="product-description" style="font-family: 'Inter', sans-serif; font-size: 16px; line-height: 1.8; color: rgba(255, 255, 255, 0.8); margin-bottom: 32px; padding: 24px; background: rgba(255, 255, 255, 0.05); border-radius: 16px;">
          {{ product.description }}
        </div>

        <form method="post" action="/cart/add" id="AddToCartForm" style="margin-bottom: 32px;">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          <div style="margin-bottom: 24px;">
            <label style="color: white; margin-bottom: 10px; display: block;">Quantity</label>
            <input type="number" name="quantity" value="1" min="1" style="width: 100px; padding: 12px; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.1); color: white;">
          </div>

          <button type="submit" name="add" class="luxury-cta-primary" style="width: 100%; font-size: 1.2rem;">
            Add to Cart
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
@media (max-width: 1024px) {
  .product-layout { grid-template-columns: 1fr !important; gap: 40px !important; }
  .product-images { position: static !important; }
}
</style>

{% schema %}
{ "name": "Main Product", "settings": [], "presets": [{ "name": "Main Product" }] }
{% endschema %}