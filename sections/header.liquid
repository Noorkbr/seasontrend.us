{% comment %}
  Arctic Header Section
  =====================
  Premium fixed header with announcement bar, navigation, and cart.
  
  MERCHANT CUSTOMIZATION (via Shopify Theme Editor):
  - Upload custom logo and set width
  - Add rotating announcement messages (via blocks)
  - Navigation pulls from Shopify Navigation settings (main-menu)
  - Cart count updates automatically with AJAX
  
  To edit: Theme Editor > Header section
{% endcomment %}

<header class="arctic-header" id="arctic-header">
  {%- comment -%} Announcement Bar {%- endcomment -%}
  {% if section.blocks.size > 0 or section.settings.show_announcement %}
    <div class="arctic-header-top">
      <div class="container">
        <div class="arctic-announcement-bar" id="arctic-announcement-bar">
          <div class="announcement-track">
            {% for block in section.blocks %}
              {% if block.type == 'announcement' %}
                <div class="announcement-item {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
                  {% if block.settings.link != blank %}
                    <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
                  {% else %}
                    {{ block.settings.text }}
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
            {% if section.blocks.size == 0 %}
              <div class="announcement-item active">{{ section.settings.default_announcement | default: 'Welcome to ' | append: shop.name }}</div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endif %}
  
  {%- comment -%} Main Navigation Bar {%- endcomment -%}
  <nav class="arctic-navbar" role="navigation" aria-label="Main navigation">
    <div class="container">
      <div class="arctic-navbar-content">
        {%- comment -%} Logo {%- endcomment -%}
        <div class="arctic-logo">
          {% if section.settings.logo %}
            <a href="/" class="logo-link" aria-label="{{ shop.name }} - Home">
              <img 
                src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}" 
                alt="{{ shop.name }}"
                width="{{ section.settings.logo_width }}"
                height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round }}"
                style="max-width: {{ section.settings.logo_width }}px; height: auto;"
                loading="eager">
            </a>
          {% else %}
            <a href="/" class="logo-link seasontrend-logo" aria-label="{{ shop.name }} - Home">
              <span class="logo-icon">
                <svg width="38" height="38" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <linearGradient id="header-aurora" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" style="stop-color:#00F2FF"/>
                      <stop offset="50%" style="stop-color:#8B5CF6"/>
                      <stop offset="100%" style="stop-color:#BD00FF"/>
                    </linearGradient>
                    <linearGradient id="header-gold" x1="0%" y1="0%" x2="100%" y2="0%">
                      <stop offset="0%" style="stop-color:#BF953F"/>
                      <stop offset="25%" style="stop-color:#FCF6BA"/>
                      <stop offset="50%" style="stop-color:#D4AF37"/>
                      <stop offset="75%" style="stop-color:#FCF6BA"/>
                      <stop offset="100%" style="stop-color:#BF953F"/>
                    </linearGradient>
                    <filter id="header-glow" x="-50%" y="-50%" width="200%" height="200%">
                      <feGaussianBlur stdDeviation="1.5" result="blur"/>
                      <feMerge>
                        <feMergeNode in="blur"/>
                        <feMergeNode in="SourceGraphic"/>
                      </feMerge>
                    </filter>
                  </defs>
                  <!-- Snowflake Icon -->
                  <g transform="translate(32, 32)" filter="url(#header-glow)">
                    <polygon points="0,-4 4,0 0,4 -4,0" fill="url(#header-aurora)"/>
                    <g stroke="url(#header-aurora)" stroke-width="2" stroke-linecap="round">
                      <line x1="0" y1="-6" x2="0" y2="-22"/>
                      <line x1="0" y1="6" x2="0" y2="22"/>
                      <line x1="-6" y1="0" x2="-22" y2="0"/>
                      <line x1="6" y1="0" x2="22" y2="0"/>
                      <line x1="-4" y1="-4" x2="-16" y2="-16"/>
                      <line x1="4" y1="4" x2="16" y2="16"/>
                      <line x1="-4" y1="4" x2="-16" y2="16"/>
                      <line x1="4" y1="-4" x2="16" y2="-16"/>
                    </g>
                    <g fill="url(#header-gold)">
                      <circle cx="0" cy="-24" r="2.5"/>
                      <circle cx="0" cy="24" r="2.5"/>
                      <circle cx="-24" cy="0" r="2.5"/>
                      <circle cx="24" cy="0" r="2.5"/>
                    </g>
                  </g>
                </svg>
              </span>
              <span class="logo-text">
                <span class="logo-season">SEASON</span><span class="logo-trend">TREND</span>
              </span>
              <span class="logo-tagline">{{ section.settings.logo_tagline | default: 'PREMIUM STYLE • EVERY SEASON' }}</span>
            </a>
          {% endif %}
        </div>
        
        {%- comment -%} Desktop Navigation Menu {%- endcomment -%}
        <ul class="arctic-nav-menu" id="arctic-nav-menu" role="menubar">
          {% if section.settings.show_new_arrivals %}
            <li role="none"><a href="{{ section.settings.new_arrivals_link | default: '/collections/new-arrivals' }}" class="luxury-accent" role="menuitem">{{ section.settings.new_arrivals_text | default: 'NEW ARRIVALS' }}</a></li>
          {% endif %}
          {% if section.settings.show_best_sellers %}
            <li role="none"><a href="{{ section.settings.best_sellers_link | default: '/collections/best-sellers' }}" class="luxury-accent" role="menuitem">{{ section.settings.best_sellers_text | default: 'BEST SELLERS' }}</a></li>
          {% endif %}
          {% for link in linklists[section.settings.menu].links %}
            <li role="none">
              <a href="{{ link.url }}" role="menuitem" {% if link.current %}aria-current="page"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
          {% if section.settings.show_sale_link %}
            <li role="none"><a href="{{ section.settings.sale_link | default: '/collections/sale' }}" class="sale-link" role="menuitem">{{ section.settings.sale_text | default: 'SALE' }}</a></li>
          {% endif %}
        </ul>
        
        {%- comment -%} Action Buttons {%- endcomment -%}
        <div class="arctic-nav-actions">
          {% if section.settings.show_search %}
            <a href="/search" class="arctic-icon-btn search-btn" aria-label="Search">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
              </svg>
            </a>
          {% endif %}
          
          <a href="/cart" class="arctic-icon-btn cart-btn" id="arctic-cart-btn" aria-label="Cart ({{ cart.item_count }} items)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
            </svg>
            <span class="arctic-cart-count" id="arctic-cart-count" data-cart-count aria-live="polite">{{ cart.item_count }}</span>
          </a>
          
          {% if section.settings.show_cta_button %}
            <a href="{{ section.settings.cta_link | default: '/collections/all' }}" class="arctic-cta-btn">
              {{ section.settings.cta_text | default: 'Shop Now' }}
            </a>
          {% endif %}
        </div>
        
        {%- comment -%} Mobile Menu Toggle {%- endcomment -%}
        <button class="arctic-mobile-toggle" id="arctic-mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="arctic-nav-menu">
          <span class="hamburger-icon" aria-hidden="true">☰</span>
        </button>
      </div>
    </div>
  </nav>
</header>

<style>
/* Announcement Bar Styles */
.announcement-item {
  display: none;
  color: rgba(255, 255, 255, 0.9);
}

.announcement-item.active {
  display: block;
}

.announcement-item a {
  color: inherit;
  text-decoration: none;
  padding: 0.5rem;
  display: inline-block;
}

.announcement-item a:hover {
  text-decoration: underline;
}

/* Cart Count Badge */
.arctic-cart-count {
  position: absolute;
  top: -4px;
  right: -4px;
  min-width: 18px;
  height: 18px;
  padding: 0 5px;
  font-size: 11px;
  font-weight: 700;
  line-height: 18px;
  text-align: center;
  color: white;
  background: linear-gradient(135deg, #00F2FF, #BD00FF);
  border-radius: 50px;
}

.arctic-cart-count:empty,
.arctic-cart-count[data-cart-count="0"] {
  display: none;
}

.arctic-icon-btn {
  position: relative;
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Sale Link Styling */
.sale-link {
  color: #FF6B6B !important;
  font-weight: 600 !important;
}

/* Search Button */
.search-btn svg {
  stroke: currentColor;
}

/* Mobile Hamburger Animation */
.arctic-mobile-toggle .hamburger-icon {
  display: block;
  font-size: 1.5rem;
}

/* Mobile Toggle Button - Hidden on desktop, visible on mobile */
.arctic-mobile-toggle {
  display: none;
  min-width: 48px;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  color: white;
  cursor: pointer;
}

/* Show mobile toggle only on mobile devices */
@media (max-width: 768px) {
  .arctic-mobile-toggle {
    display: flex;
  }
}

/* Ensure logo link is accessible */
.logo-link {
  display: inline-flex;
  align-items: center;
  min-height: 48px;
  min-width: 48px;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.logo-link:focus-visible {
  outline: 2px solid rgba(0, 242, 255, 0.6);
  outline-offset: 4px;
  border-radius: 4px;
}

/* SeasonTrend Premium Logo Styles */
.seasontrend-logo {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  text-decoration: none;
  position: relative;
  padding: 0.625rem 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.seasontrend-logo .logo-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  flex-shrink: 0;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.seasontrend-logo .logo-icon svg {
  filter: drop-shadow(0 0 6px rgba(0, 242, 255, 0.3));
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.seasontrend-logo:hover .logo-icon {
  transform: scale(1.08) rotate(8deg);
}

.seasontrend-logo:hover .logo-icon svg {
  filter: drop-shadow(0 0 12px rgba(0, 242, 255, 0.5)) drop-shadow(0 0 20px rgba(139, 92, 246, 0.3));
}

.seasontrend-logo .logo-text {
  display: flex;
  align-items: baseline;
  font-family: var(--font-clash, 'Inter', sans-serif);
  font-weight: 700;
  font-size: 1.6rem;
  letter-spacing: 0.1em;
  line-height: 1;
  position: relative;
  transition: all 0.3s ease;
}

.seasontrend-logo .logo-season {
  background: linear-gradient(135deg, #00F2FF 0%, #8B5CF6 50%, #BD00FF 100%);
  background-size: 200% 200%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gradientFlow 5s ease infinite;
  text-shadow: none;
  filter: drop-shadow(0 0 6px rgba(0, 242, 255, 0.3));
  transition: filter 0.3s ease;
}

.seasontrend-logo .logo-trend {
  background: linear-gradient(90deg, #BF953F 0%, #FCF6BA 25%, #D4AF37 50%, #FCF6BA 75%, #BF953F 100%);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: goldShimmer 4s ease infinite;
  transition: filter 0.3s ease;
}

.seasontrend-logo .logo-tagline {
  position: absolute;
  bottom: -16px;
  left: 0;
  right: 0;
  font-family: var(--font-satoshi, 'Inter', sans-serif);
  font-size: 0.5rem;
  font-weight: 500;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: rgba(192, 192, 192, 0.7);
  opacity: 0;
  transform: translateY(-4px);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  text-align: center;
  pointer-events: none;
}

.seasontrend-logo:hover .logo-tagline {
  opacity: 1;
  transform: translateY(0);
  color: rgba(192, 192, 192, 0.95);
}

.seasontrend-logo:hover .logo-season {
  filter: drop-shadow(0 0 10px rgba(0, 242, 255, 0.5)) brightness(1.1);
}

.seasontrend-logo:hover .logo-trend {
  filter: brightness(1.15) drop-shadow(0 0 8px rgba(212, 175, 55, 0.3));
}

/* Logo Animations */
@keyframes gradientFlow {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

@keyframes goldShimmer {
  0%, 100% { background-position: 0% 0%; }
  50% { background-position: 100% 0%; }
}

/* Mobile Logo Adjustments */
@media (max-width: 768px) {
  .seasontrend-logo {
    gap: 0.625rem;
    padding: 0.5rem 0;
  }
  
  .seasontrend-logo .logo-icon {
    width: 40px;
    height: 40px;
  }
  
  .seasontrend-logo .logo-icon svg {
    width: 34px;
    height: 34px;
  }
  
  .seasontrend-logo .logo-text {
    font-size: 1.3rem;
    letter-spacing: 0.08em;
  }
  
  .seasontrend-logo .logo-tagline {
    display: none;
  }
  
  .seasontrend-logo:hover .logo-icon {
    transform: scale(1.05) rotate(5deg);
  }
}

@media (max-width: 480px) {
  .seasontrend-logo {
    gap: 0.5rem;
  }
  
  .seasontrend-logo .logo-icon {
    width: 38px;
    height: 38px;
  }
  
  .seasontrend-logo .logo-icon svg {
    width: 32px;
    height: 32px;
  }
  
  .seasontrend-logo .logo-text {
    font-size: 1.1rem;
    letter-spacing: 0.06em;
  }
}
</style>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "arctic-header-section",
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 150
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Text Logo (if no image)",
      "info": "Displayed if no logo image is uploaded"
    },
    {
      "type": "text",
      "id": "logo_tagline",
      "label": "Logo Tagline",
      "default": "PREMIUM STYLE • EVERY SEASON",
      "info": "Tagline shown below the logo text"
    },
    {
      "type": "header",
      "content": "Announcement Bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "default_announcement",
      "label": "Default Announcement",
      "default": "Free Shipping on Orders Over $50"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu",
      "info": "Select your main navigation menu"
    },
    {
      "type": "checkbox",
      "id": "show_new_arrivals",
      "label": "Show New Arrivals Link",
      "default": true
    },
    {
      "type": "text",
      "id": "new_arrivals_text",
      "label": "New Arrivals Text",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "url",
      "id": "new_arrivals_link",
      "label": "New Arrivals Link"
    },
    {
      "type": "checkbox",
      "id": "show_best_sellers",
      "label": "Show Best Sellers Link",
      "default": true
    },
    {
      "type": "text",
      "id": "best_sellers_text",
      "label": "Best Sellers Text",
      "default": "BEST SELLERS"
    },
    {
      "type": "url",
      "id": "best_sellers_link",
      "label": "Best Sellers Link"
    },
    {
      "type": "checkbox",
      "id": "show_sale_link",
      "label": "Show Sale Link",
      "default": true
    },
    {
      "type": "text",
      "id": "sale_text",
      "label": "Sale Text",
      "default": "SALE"
    },
    {
      "type": "url",
      "id": "sale_link",
      "label": "Sale Link"
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cta_button",
      "label": "Show CTA Button",
      "default": true,
      "info": "Shop Now button (hidden on mobile)"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "Free Shipping Over $50"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "announcement",
        "settings": {
          "text": "Free Shipping Over $50 🚚"
        }
      },
      {
        "type": "announcement",
        "settings": {
          "text": "New Arrivals Just Dropped! ✨"
        }
      },
      {
        "type": "announcement",
        "settings": {
          "text": "24/7 Customer Support 💬"
        }
      }
    ]
  }
}
{% endschema %}