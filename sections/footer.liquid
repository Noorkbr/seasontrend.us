<footer class="luxury-footer">
  <div class="container">
    
    <div class="luxury-footer-trust">
      {% render 'trust-badges' %}
    </div>
    
    <div class="luxury-newsletter-section">
      <div class="luxury-newsletter-content">
        <div class="luxury-newsletter-text">
          <h3 class="luxury-newsletter-title">JOIN THE VIP LIST</h3>
          <p class="luxury-newsletter-subtitle">Get 10% off your first order + exclusive deals</p>
        </div>
        <form class="luxury-newsletter-form" action="/contact#newsletter" method="post" accept-charset="UTF-8">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="luxury-newsletter-input-group">
            <input 
              type="email" 
              name="contact[email]" 
              placeholder="Enter your email"
              class="luxury-newsletter-input"
              required
              aria-label="Email address"
            >
            <button type="submit" class="luxury-newsletter-btn">
              Subscribe
            </button>
          </div>
        </form>
      </div>
    </div>
    
    <div class="luxury-social-proof-summary">
      <span class="proof-stars">⭐⭐⭐⭐⭐</span>
      <span class="proof-text">4.8/5 from 1,247+ reviews</span>
    </div>
    
    <div class="luxury-footer-nav">
      <div class="luxury-footer-column">
        <h4 class="luxury-footer-heading">Shop</h4>
        <ul class="luxury-footer-links">
          <li><a href="/collections/all">All Collections</a></li>
          <li><a href="/collections/new-arrivals">New Arrivals</a></li>
          <li><a href="/collections/best-sellers">Best Sellers</a></li>
          <li><a href="/collections/sale">Sale</a></li>
        </ul>
      </div>
      
      <div class="luxury-footer-column">
        <h4 class="luxury-footer-heading">Help</h4>
        <ul class="luxury-footer-links">
          <li><a href="/pages/contact">Contact Us</a></li>
          <li><a href="/pages/shipping">Shipping Info</a></li>
          <li><a href="/pages/returns">Returns & Exchanges</a></li>
          <li><a href="/pages/faq">FAQ</a></li>
        </ul>
      </div>
      
      <div class="luxury-footer-column">
        <h4 class="luxury-footer-heading">About</h4>
        <ul class="luxury-footer-links">
          <li><a href="/pages/about">Our Story</a></li>
          <li><a href="/pages/reviews">Customer Reviews</a></li>
          <li><a href="/blogs/news">Blog</a></li>
          <li><a href="/pages/careers">Careers</a></li>
        </ul>
      </div>
      
      <div class="luxury-footer-column">
        <h4 class="luxury-footer-heading">Connect</h4>
        <div class="luxury-footer-social">
          {% if section.settings.facebook_url %}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook" class="social-icon">
              <span>📘</span>
            </a>
          {% endif %}
          {% if section.settings.instagram_url %}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram" class="social-icon">
              <span>📷</span>
            </a>
          {% endif %}
          {% if section.settings.twitter_url %}
            <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener" aria-label="Twitter" class="social-icon">
              <span>🐦</span>
            </a>
          {% endif %}
          {% if section.settings.pinterest_url %}
            <a href="{{ section.settings.pinterest_url }}" target="_blank" rel="noopener" aria-label="Pinterest" class="social-icon">
              <span>📌</span>
            </a>
          {% endif %}
          {% if section.settings.tiktok_url %}
            <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok" class="social-icon">
              <span>🎵</span>
            </a>
          {% endif %}
        </div>
        
        <div class="luxury-footer-contact">
          {% if section.settings.email %}
            <a href="mailto:{{ section.settings.email }}" class="contact-link">
              <span class="icon">📧</span>
              <span>{{ section.settings.email }}</span>
            </a>
          {% endif %}
          {% if section.settings.phone %}
            <a href="tel:{{ section.settings.phone }}" class="contact-link">
              <span class="icon">📞</span>
              <span>{{ section.settings.phone }}</span>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
    
    <div class="luxury-footer-bottom">
      <div class="luxury-footer-copyright">
        <p>© {{ 'now' | date: "%Y" }} {{ shop.name }}. {{ section.settings.copyright_text | default: "All rights reserved." }}</p>
      </div>
      
      <div class="luxury-footer-legal">
        {% if section.settings.show_legal_links %}
          <a href="/pages/privacy-policy">Privacy Policy</a>
          <a href="/pages/terms-of-service">Terms of Service</a>
          <a href="/pages/refund-policy">Refund Policy</a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "header",
      "content": "Contact Information"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "header",
      "content": "Legal"
    },
    {
      "type": "checkbox",
      "id": "show_legal_links",
      "label": "Show Legal Links",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "All rights reserved."
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
