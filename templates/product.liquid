<div class="product-template">
  <div class="container">
    <div class="product-single">
      <div class="product-single__photos">
        {% if product.images.size > 0 %}
          <div class="product-single__photo">
            <img src="{{ product.featured_image | img_url: 'large' }}" 
                 alt="{{ product.featured_image.alt | escape }}"
                 id="ProductPhotoImg">
          </div>
          
          {% if product.images.size > 1 %}
            <div class="product-single__thumbnails">
              {% for image in product.images %}
                <div class="product-single__thumbnail">
                  <img src="{{ image.src | img_url: 'compact' }}" 
                       alt="{{ image.alt | escape }}">
                </div>
              {% endfor %}
            </div>
          {% endif %}
        {% endif %}
      </div>

      <div class="product-single__info">
        <h1 class="product-single__title">{{ product.title }}</h1>
        
        {% if settings.product_show_vendor %}
          <p class="product-single__vendor">{{ product.vendor }}</p>
        {% endif %}
        
        <div class="product-single__prices">
          {% if product.compare_at_price_max > product.price %}
            <span class="product-single__price product-single__price--sale">
              {{ product.price | money }}
            </span>
            <span class="product-single__price product-single__price--compare">
              {{ product.compare_at_price | money }}
            </span>
          {% else %}
            <span class="product-single__price">
              {{ product.price | money }}
            </span>
          {% endif %}
        </div>

        {% if settings.product_show_sku %}
          <p class="product-single__sku">SKU: {{ product.selected_or_first_available_variant.sku }}</p>
        {% endif %}

        <div class="product-single__description rte">
          {{ product.description }}
        </div>

        <form method="post" action="/cart/add" id="AddToCartForm" class="product-form">
          <select name="id" id="productSelect" class="product-form__variants">
            {% for variant in product.variants %}
              <option 
                {% if variant == product.selected_or_first_available_variant %} selected="selected" {% endif %}
                {% unless variant.available %} disabled="disabled" {% endunless %}
                value="{{ variant.id }}">
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>

          <div class="product-form__item product-form__item--quantity">
            <label for="Quantity">{{ 'products.product.quantity' | t }}</label>
            <input type="number" id="Quantity" name="quantity" value="1" min="1" class="product-form__input">
          </div>

          <div class="product-form__item product-form__item--submit">
            <button type="submit" name="add" id="AddToCart" class="btn btn-primary btn-lg product-form__cart-submit">
              <span id="AddToCartText">{{ 'products.product.add_to_cart' | t }}</span>
            </button>
          </div>
        </form>

        <div class="product-single__policies rte">
          <p>🚚 Free shipping on orders over $50</p>
          <p>🔒 Secure checkout</p>
          <p>↩️ 30-day money-back guarantee</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.product-template {
  padding: 60px 0;
}

.product-single {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  max-width: 1280px;
  margin: 0 auto;
}

.product-single__photo img {
  width: 100%;
  height: auto;
  border-radius: 8px;
}

.product-single__thumbnails {
  display: flex;
  gap: 10px;
  margin-top: 10px;
}

.product-single__thumbnail {
  width: 80px;
  height: 80px;
  cursor: pointer;
  border: 2px solid transparent;
  border-radius: 4px;
  overflow: hidden;
}

.product-single__thumbnail:hover {
  border-color: var(--primary-color, #6366f1);
}

.product-single__thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-single__title {
  font-size: 32px;
  font-weight: 700;
  margin-bottom: 10px;
}

.product-single__vendor {
  color: #666;
  margin-bottom: 15px;
}

.product-single__prices {
  margin: 20px 0;
  font-size: 24px;
  font-weight: 600;
}

.product-single__price--sale {
  color: #ec4899;
  margin-right: 10px;
}

.product-single__price--compare {
  text-decoration: line-through;
  color: #999;
  font-size: 18px;
}

.product-single__description {
  margin: 20px 0;
  line-height: 1.6;
}

.product-form__variants {
  width: 100%;
  padding: 12px;
  border: 2px solid #e5e7eb;
  border-radius: 8px;
  font-size: 16px;
  margin-bottom: 20px;
}

.product-form__item {
  margin-bottom: 20px;
}

.product-form__input {
  width: 100%;
  padding: 12px;
  border: 2px solid #e5e7eb;
  border-radius: 8px;
  font-size: 16px;
}

.product-single__policies {
  margin-top: 30px;
  padding: 20px;
  background: #f9fafb;
  border-radius: 8px;
}

.product-single__policies p {
  margin: 10px 0;
}

@media (max-width: 768px) {
  .product-single {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .product-single__title {
    font-size: 24px;
  }
}
</style>
