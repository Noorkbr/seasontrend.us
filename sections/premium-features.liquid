{% comment %}
  Premium Features Section
  ========================
  Showcase key brand features with animated icons and premium styling.
  
  To edit: Theme Editor > Home page > Premium Features
{% endcomment %}

<section class="premium-features-section">
  <div class="container">
    <div class="features-header">
      <h2 class="features-title">
        {{ section.settings.title | default: 'Why Choose Us' }}
      </h2>
      {% if section.settings.subtitle %}
        <p class="features-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>
    
    <div class="features-grid">
      {% for block in section.blocks %}
        <div class="feature-card" {{ block.shopify_attributes }}>
          <div class="feature-icon-wrapper">
            <div class="feature-icon">
              {{ block.settings.icon | default: '✨' }}
            </div>
            <div class="feature-glow"></div>
          </div>
          <h3 class="feature-title">{{ block.settings.title }}</h3>
          <p class="feature-description">{{ block.settings.description }}</p>
        </div>
      {% endfor %}
      
      {% if section.blocks.size == 0 %}
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <div class="feature-icon">🚚</div>
            <div class="feature-glow"></div>
          </div>
          <h3 class="feature-title">Free Shipping</h3>
          <p class="feature-description">Free worldwide shipping on all orders over $50</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <div class="feature-icon">↩️</div>
            <div class="feature-glow"></div>
          </div>
          <h3 class="feature-title">Easy Returns</h3>
          <p class="feature-description">30-day hassle-free returns & exchanges</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <div class="feature-icon">🔒</div>
            <div class="feature-glow"></div>
          </div>
          <h3 class="feature-title">Secure Checkout</h3>
          <p class="feature-description">256-bit SSL encryption for safe payments</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <div class="feature-icon">💬</div>
            <div class="feature-glow"></div>
          </div>
          <h3 class="feature-title">24/7 Support</h3>
          <p class="feature-description">Expert customer support around the clock</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
.premium-features-section {
  background: var(--arctic-void, #05080F);
  padding: clamp(4rem, 10vw, 8rem) 2rem;
  position: relative;
  overflow: hidden;
}

.premium-features-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(ellipse at 30% 0%, rgba(0, 242, 255, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 70% 100%, rgba(189, 0, 255, 0.08) 0%, transparent 50%);
  pointer-events: none;
}

.features-header {
  text-align: center;
  margin-bottom: 4rem;
  position: relative;
  z-index: 1;
}

.features-title {
  font-family: var(--font-clash, 'Inter', sans-serif);
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 800;
  color: white;
  margin: 0 0 1rem;
  letter-spacing: -0.02em;
}

.features-subtitle {
  font-family: var(--font-satoshi, 'Inter', sans-serif);
  font-size: 1.125rem;
  color: rgba(255, 255, 255, 0.7);
  margin: 0;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
  max-width: 1400px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.feature-card {
  text-align: center;
  padding: 2.5rem 1.5rem;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 1.5rem;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.feature-card::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: 1.5rem;
  padding: 1px;
  background: linear-gradient(135deg, rgba(0, 242, 255, 0.3), rgba(189, 0, 255, 0.3));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.feature-card:hover::before {
  opacity: 1;
}

.feature-card:hover {
  transform: translateY(-8px);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0.04) 100%);
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3), 0 0 60px rgba(0, 242, 255, 0.1);
}

.feature-icon-wrapper {
  position: relative;
  width: 80px;
  height: 80px;
  margin: 0 auto 1.5rem;
}

.feature-icon {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.5rem;
  background: linear-gradient(135deg, rgba(0, 242, 255, 0.15), rgba(189, 0, 255, 0.15));
  border: 1px solid rgba(0, 242, 255, 0.2);
  border-radius: 1.25rem;
  position: relative;
  z-index: 1;
  transition: all 0.4s ease;
}

.feature-card:hover .feature-icon {
  transform: scale(1.1);
  border-color: rgba(0, 242, 255, 0.4);
}

.feature-glow {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100%;
  height: 100%;
  background: radial-gradient(circle, rgba(0, 242, 255, 0.3) 0%, transparent 70%);
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.4s ease;
}

.feature-card:hover .feature-glow {
  opacity: 1;
  animation: pulse-glow 2s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
  50% { transform: translate(-50%, -50%) scale(1.3); opacity: 0.8; }
}

.feature-title {
  font-family: var(--font-satoshi, 'Inter', sans-serif);
  font-size: 1.25rem;
  font-weight: 700;
  color: white;
  margin: 0 0 0.75rem;
}

.feature-description {
  font-family: var(--font-satoshi, 'Inter', sans-serif);
  font-size: 0.9375rem;
  color: rgba(255, 255, 255, 0.6);
  margin: 0;
  line-height: 1.6;
}

@media (max-width: 1024px) {
  .features-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
}

@media (max-width: 640px) {
  .features-grid {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  
  .feature-card {
    padding: 2rem 1.25rem;
  }
  
  .features-header {
    margin-bottom: 2.5rem;
  }
}
</style>

{% schema %}
{
  "name": "Premium Features",
  "tag": "section",
  "class": "premium-features",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Why Choose Us"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Experience the difference with our premium service and quality products"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "✨"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Describe this amazing feature here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium Features",
      "category": "Arctic Neo-Luxury",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "🚚",
            "title": "Free Shipping",
            "description": "Free worldwide shipping on all orders over $50"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "↩️",
            "title": "Easy Returns",
            "description": "30-day hassle-free returns & exchanges"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🔒",
            "title": "Secure Checkout",
            "description": "256-bit SSL encryption for safe payments"
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "💬",
            "title": "24/7 Support",
            "description": "Expert customer support around the clock"
          }
        }
      ]
    }
  ]
}
{% endschema %}
