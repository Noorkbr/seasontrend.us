<!-- Main Product Section -->
<section class="main-product-section" style="
  padding: 60px 0;
  background: var(--arctic-void, #05080F);
">
  <div class="container" style="max-width: 1400px; margin: 0 auto; padding: 0 20px;">
    <div class="product-layout" style="
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: start;
    ">
      <!-- Product Images -->
      <div class="product-images" style="position: sticky; top: 100px;">
        <div class="main-image" style="
          background: rgba(255, 255, 255, 0.03);
          backdrop-filter: blur(20px);
          border: 1px solid rgba(255, 255, 255, 0.1);
          border-radius: 24px;
          overflow: hidden;
          margin-bottom: 20px;
          aspect-ratio: 1;
        ">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | img_url: '1000x1000' }}" 
                 alt="{{ product.featured_image.alt | escape }}"
                 style="width: 100%; height: 100%; object-fit: cover;">
          {% else %}
            <div style="
              width: 100%;
              height: 100%;
              background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
              display: flex;
              align-items: center;
              justify-content: center;
            ">
              <span style="font-size: 80px;">📦</span>
            </div>
          {% endif %}
        </div>
        
        {% if product.images.size > 1 %}
          <div class="thumbnail-grid" style="
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
            gap: 12px;
          ">
            {% for image in product.images limit: 6 %}
              <div class="thumbnail" style="
                aspect-ratio: 1;
                border-radius: 12px;
                overflow: hidden;
                cursor: pointer;
                border: 2px solid rgba(255, 255, 255, 0.1);
                transition: border-color 0.2s ease;
              ">
                <img src="{{ image | img_url: '200x200' }}" 
                     alt="{{ image.alt | escape }}"
                     style="width: 100%; height: 100%; object-fit: cover;">
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <!-- Product Info -->
      <div class="product-info">
        <!-- Breadcrumbs -->
        <div class="breadcrumbs" style="
          font-family: 'Inter', sans-serif;
          font-size: 14px;
          color: rgba(255, 255, 255, 0.5);
          margin-bottom: 24px;
        ">
          <a href="/" style="color: rgba(255, 255, 255, 0.5); text-decoration: none;">Home</a>
          <span style="margin: 0 8px;">/</span>
          <a href="/collections/{{ product.type | handle }}" style="color: rgba(255, 255, 255, 0.5); text-decoration: none;">{{ product.type }}</a>
          <span style="margin: 0 8px;">/</span>
          <span style="color: rgba(255, 255, 255, 0.8);">{{ product.title }}</span>
        </div>

        <!-- Product Title -->
        <h1 style="
          font-family: 'Playfair Display', serif;
          font-size: 48px;
          font-weight: 700;
          color: rgba(255, 255, 255, 0.95);
          margin-bottom: 16px;
          line-height: 1.2;
        ">{{ product.title }}</h1>

        <!-- Rating and Reviews -->
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
          <div class="rating-stars" style="font-size: 20px; color: #D4AF37;">★★★★★</div>
          <span style="font-family: 'Inter', sans-serif; font-size: 16px; color: rgba(255, 255, 255, 0.7);">
            4.8 (1,247 reviews)
          </span>
          <span style="
            padding: 4px 12px;
            background: rgba(16, 185, 129, 0.2);
            border-radius: 50px;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            font-weight: 600;
            color: #10b981;
          ">In Stock</span>
        </div>

        <!-- Price -->
        <div class="product-price" style="margin-bottom: 32px;">
          {% if product.compare_at_price_max > product.price %}
            <div style="display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap;">
              <span style="
                font-family: 'Inter', sans-serif;
                font-size: 48px;
                font-weight: 700;
                background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
              ">{{ product.price | money }}</span>
              <span style="
                font-family: 'Inter', sans-serif;
                font-size: 32px;
                font-weight: 500;
                color: rgba(255, 255, 255, 0.4);
                text-decoration: line-through;
              ">{{ product.compare_at_price | money }}</span>
              <span style="
                padding: 6px 16px;
                background: linear-gradient(135deg, #ec4899 0%, #db2777 100%);
                border-radius: 50px;
                font-family: 'Inter', sans-serif;
                font-size: 16px;
                font-weight: 700;
                color: white;
              ">SAVE {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
            </div>
          {% else %}
            <span style="
              font-family: 'Inter', sans-serif;
              font-size: 48px;
              font-weight: 700;
              background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
              -webkit-background-clip: text;
              -webkit-text-fill-color: transparent;
              background-clip: text;
            ">{{ product.price | money }}</span>
          {% endif %}
        </div>

        <!-- Description -->
        <div class="product-description" style="
          font-family: 'Inter', sans-serif;
          font-size: 16px;
          line-height: 1.8;
          color: rgba(255, 255, 255, 0.75);
          margin-bottom: 32px;
          padding: 24px;
          background: rgba(255, 255, 255, 0.03);
          backdrop-filter: blur(20px);
          border: 1px solid rgba(255, 255, 255, 0.1);
          border-radius: 16px;
        ">
          {{ product.description }}
        </div>

        <!-- Add to Cart Form -->
        <form method="post" action="/cart/add" id="AddToCartForm" style="margin-bottom: 32px;">
          {% if product.variants.size > 1 %}
            <div style="margin-bottom: 24px;">
              <label style="
                font-family: 'Inter', sans-serif;
                font-size: 14px;
                font-weight: 600;
                color: rgba(255, 255, 255, 0.9);
                display: block;
                margin-bottom: 12px;
              ">Select Variant:</label>
              <select name="id" style="
                width: 100%;
                padding: 16px 20px;
                background: rgba(255, 255, 255, 0.05);
                border: 2px solid rgba(255, 255, 255, 0.2);
                border-radius: 12px;
                font-family: 'Inter', sans-serif;
                font-size: 16px;
                color: rgba(255, 255, 255, 0.9);
                cursor: pointer;
              ">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }} - {{ variant.price | money }}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {% endif %}

          <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 24px;">
            <label style="
              font-family: 'Inter', sans-serif;
              font-size: 14px;
              font-weight: 600;
              color: rgba(255, 255, 255, 0.9);
            ">Quantity:</label>
            <input type="number" name="quantity" value="1" min="1" style="
              width: 100px;
              padding: 16px;
              background: rgba(255, 255, 255, 0.05);
              border: 2px solid rgba(255, 255, 255, 0.2);
              border-radius: 12px;
              font-family: 'Inter', sans-serif;
              font-size: 18px;
              font-weight: 600;
              color: rgba(255, 255, 255, 0.9);
              text-align: center;
            ">
          </div>

          <button type="submit" style="
            width: 100%;
            padding: 20px;
            background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
            border: none;
            border-radius: 50px;
            font-family: 'Inter', sans-serif;
            font-size: 20px;
            font-weight: 700;
            color: white;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 8px 24px rgba(0, 242, 255, 0.3);
            margin-bottom: 16px;
          ">
            🛒 Add to Cart
          </button>

          <button type="button" style="
            width: 100%;
            padding: 20px;
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 50px;
            font-family: 'Inter', sans-serif;
            font-size: 18px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.9);
            cursor: pointer;
            transition: all 0.3s ease;
          ">
            Buy with Shop Pay
          </button>
        </form>

        <!-- Product Features -->
        <div class="product-features" style="
          display: grid;
          grid-template-columns: repeat(2, 1fr);
          gap: 16px;
          margin-bottom: 32px;
        ">
          <div style="
            padding: 20px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
          ">
            <span style="font-size: 28px;">🚚</span>
            <div>
              <div style="font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; color: rgba(255, 255, 255, 0.9);">Free Shipping</div>
              <div style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255, 255, 255, 0.6);">On orders over $50</div>
            </div>
          </div>

          <div style="
            padding: 20px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
          ">
            <span style="font-size: 28px;">✓</span>
            <div>
              <div style="font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; color: rgba(255, 255, 255, 0.9);">30-Day Returns</div>
              <div style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255, 255, 255, 0.6);">Money-back guarantee</div>
            </div>
          </div>

          <div style="
            padding: 20px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
          ">
            <span style="font-size: 28px;">🔒</span>
            <div>
              <div style="font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; color: rgba(255, 255, 255, 0.9);">Secure Checkout</div>
              <div style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255, 255, 255, 0.6);">SSL encrypted</div>
            </div>
          </div>

          <div style="
            padding: 20px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
          ">
            <span style="font-size: 28px;">💬</span>
            <div>
              <div style="font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 600; color: rgba(255, 255, 255, 0.9);">24/7 Support</div>
              <div style="font-family: 'Inter', sans-serif; font-size: 12px; color: rgba(255, 255, 255, 0.6);">Expert assistance</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.thumbnail:hover {
  border-color: rgba(0, 242, 255, 0.5);
}

button[type="submit"]:hover {
  transform: translateY(-2px);
  box-shadow: 0 12px 32px rgba(0, 242, 255, 0.4);
}

@media (max-width: 1024px) {
  .product-layout {
    grid-template-columns: 1fr !important;
    gap: 40px !important;
  }
  
  .product-images {
    position: static !important;
  }
  
  h1 {
    font-size: 36px !important;
  }
  
  .product-price span:first-child {
    font-size: 36px !important;
  }
  
  .product-features {
    grid-template-columns: 1fr !important;
  }
}
</style>

{% schema %}
{
  "name": "Main Product",
  "settings": [],
  "presets": [
    {
      "name": "Main Product",
      "category": "Product"
    }
  ]
}
{% endschema %}
