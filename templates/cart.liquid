{% comment %}
  Cart Template - Arctic Neo-Luxury Edition
  =========================================
  Glassmorphism design with aurora gradients,
  urgency elements, and conversion boosters.
{% endcomment %}

<div class="cart-template arctic-cart">
  <div class="container">
    <!-- Urgency Banner -->
    <div class="cart-urgency-banner">
      <span class="urgency-icon">⚡</span>
      <span class="urgency-text">Items in your cart are selling fast! Complete your order now.</span>
      <span class="urgency-timer" id="cart-urgency-timer">15:00</span>
    </div>

    <h1 class="cart-title">{{ 'cart.general.title' | t }}</h1>

    {% if cart.item_count > 0 %}
      <!-- Cart viewer count -->
      <div class="cart-viewers">
        <span class="viewer-dot"></span>
        <span class="viewer-count"><span id="cart-viewer-count">{{ cart.item_count | plus: 12 }}</span> people are viewing items in your cart</span>
      </div>

      <form action="/cart" method="post" novalidate class="cart">
        <div class="cart-items glass-panel">
          {% for item in cart.items %}
            <div class="cart-item" data-cart-item data-variant-id="{{ item.variant.id }}">
              <div class="cart-item__image">
                {% if item.image %}
                  <img src="{{ item.image | img_url: 'small' }}" alt="{{ item.image.alt | escape }}">
                {% endif %}
              </div>

              <div class="cart-item__details">
                <h3 class="cart-item__title">
                  <a href="{{ item.url }}">{{ item.product.title }}</a>
                </h3>
                
                {% unless item.variant.title == 'Default Title' %}
                  <p class="cart-item__variant">{{ item.variant.title }}</p>
                {% endunless %}

                {% if item.properties %}
                  <div class="cart-item__properties">
                    {% for property in item.properties %}
                      {% assign property_first_char = property.first | slice: 0 %}
                      {% unless property.last == blank or property_first_char == '_' %}
                        <p>
                          <strong>{{ property.first }}:</strong> {{ property.last }}
                        </p>
                      {% endunless %}
                    {% endfor %}
                  </div>
                {% endif %}

                <!-- Item urgency -->
                <div class="cart-item__urgency">
                  <span class="urgency-badge">🔥 Only {{ forloop.index | plus: 2 }} left in stock!</span>
                </div>
              </div>

              <div class="cart-item__quantity">
                <label for="updates_{{ item.key }}">{{ 'products.product.quantity' | t }}</label>
                <div class="quantity-control">
                  <button type="button" class="quantity-btn quantity-minus" onclick="this.nextElementSibling.stepDown(); this.nextElementSibling.dispatchEvent(new Event('change'));">−</button>
                  <input type="number" 
                         name="updates[]" 
                         id="updates_{{ item.key }}" 
                         value="{{ item.quantity }}" 
                         min="0" 
                         data-quantity-input>
                  <button type="button" class="quantity-btn quantity-plus" onclick="this.previousElementSibling.stepUp(); this.previousElementSibling.dispatchEvent(new Event('change'));">+</button>
                </div>
              </div>

              <div class="cart-item__price">
                {% if item.original_line_price != item.line_price %}
                  <span class="cart-item__price--sale">{{ item.line_price | money }}</span>
                  <span class="cart-item__price--compare">{{ item.original_line_price | money }}</span>
                  <span class="cart-item__savings">You save {{ item.original_line_price | minus: item.line_price | money }}</span>
                {% else %}
                  <span>{{ item.line_price | money }}</span>
                {% endif %}
              </div>

              <div class="cart-item__remove">
                <a href="/cart/change?line={{ forloop.index }}&amp;quantity=0" 
                   class="cart-item__remove-link"
                   data-line="{{ forloop.index }}">
                  {{ 'cart.general.remove' | t }}
                </a>
              </div>
            </div>
          {% endfor %}
        </div>

        {% if settings.cart_notes_enable %}
          <div class="cart-note glass-panel">
            <label for="CartNote">{{ 'cart.general.note' | t }}</label>
            <textarea name="note" id="CartNote" class="cart-note__textarea">{{ cart.note }}</textarea>
          </div>
        {% endif %}

        <div class="cart-footer glass-panel">
          <!-- Free Shipping Progress -->
          <div class="free-shipping-progress">
            {% assign shipping_threshold = 5000 %}
            {% if settings.free_shipping_threshold > 0 %}
              {% assign shipping_threshold = settings.free_shipping_threshold %}
            {% endif %}
            
            {% if cart.total_price < shipping_threshold %}
              {% assign remaining = shipping_threshold | minus: cart.total_price %}
              {% assign progress = cart.total_price | times: 100 | divided_by: shipping_threshold %}
              <div class="shipping-progress-header">
                <span>🚚 Free Shipping Progress</span>
                <span class="shipping-remaining">Add {{ remaining | money }} more!</span>
              </div>
              <div class="shipping-progress-bar">
                <div class="shipping-progress-fill" style="width: {{ progress }}%;"></div>
                <div class="shipping-progress-glow"></div>
              </div>
            {% else %}
              <div class="shipping-success">
                <span class="success-icon">✨</span>
                <span>Congratulations! You've unlocked FREE SHIPPING!</span>
              </div>
            {% endif %}
          </div>

          <div class="cart-subtotal">
            <span class="cart-subtotal__title">{{ 'cart.general.subtotal' | t }}</span>
            <span class="cart-subtotal__price">{{ cart.total_price | money }}</span>
          </div>

          <!-- Trust Badges Mini -->
          <div class="cart-trust-badges">
            <div class="trust-mini-badge">
              <span>🔒</span>
              <span>Secure Checkout</span>
            </div>
            <div class="trust-mini-badge">
              <span>↩️</span>
              <span>30-Day Returns</span>
            </div>
            <div class="trust-mini-badge">
              <span>⭐</span>
              <span>50K+ Reviews</span>
            </div>
          </div>

          <div class="cart-actions">
            <button type="submit" name="update" class="btn-secondary-arctic">
              {{ 'cart.general.update' | t }}
            </button>
            <button type="submit" name="checkout" class="luxury-cta-primary checkout-btn">
              <span class="btn-icon">🔒</span>
              <span>{{ 'cart.general.checkout' | t }}</span>
            </button>
          </div>

          <a href="/collections/all" class="cart-continue-shopping">
            ← {{ 'cart.general.continue_shopping' | t }}
          </a>
        </div>
      </form>
    {% else %}
      <div class="cart-empty glass-panel">
        <div class="empty-icon">🛒</div>
        <p>{{ 'cart.general.empty' | t }}</p>
        <p class="empty-subtext">Start shopping to fill your cart with amazing products!</p>
        <a href="/collections/all" class="luxury-cta-primary">
          {{ 'cart.general.continue_shopping' | t }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<style>
/* Arctic Cart Template Styles */
.arctic-cart {
  background: var(--arctic-void, #05080F);
  padding: 60px 0;
  min-height: 80vh;
}

/* Urgency Banner */
.cart-urgency-banner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 16px 24px;
  background: linear-gradient(90deg, rgba(255, 107, 107, 0.2), rgba(255, 0, 229, 0.2), rgba(0, 242, 255, 0.2));
  border: 1px solid rgba(255, 107, 107, 0.4);
  border-radius: 16px;
  margin-bottom: 32px;
  animation: urgency-pulse 2s ease-in-out infinite;
}

@keyframes urgency-pulse {
  0%, 100% { box-shadow: 0 0 20px rgba(255, 107, 107, 0.2); }
  50% { box-shadow: 0 0 40px rgba(255, 107, 107, 0.4); }
}

.urgency-icon {
  font-size: 24px;
  animation: urgency-shake 0.5s ease-in-out infinite;
}

@keyframes urgency-shake {
  0%, 100% { transform: rotate(-5deg); }
  50% { transform: rotate(5deg); }
}

.urgency-text {
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
  font-size: 14px;
}

.urgency-timer {
  background: linear-gradient(135deg, #FF6B6B, #FF8787);
  padding: 6px 16px;
  border-radius: 50px;
  font-weight: 700;
  font-size: 14px;
  color: white;
}

/* Cart Viewers */
.cart-viewers {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-bottom: 24px;
  color: rgba(255, 255, 255, 0.7);
  font-size: 14px;
}

.viewer-dot {
  width: 8px;
  height: 8px;
  background: #10b981;
  border-radius: 50%;
  animation: viewer-blink 1.5s ease-in-out infinite;
}

@keyframes viewer-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

.cart-title {
  font-size: clamp(32px, 6vw, 48px);
  font-weight: 700;
  text-align: center;
  margin-bottom: 40px;
  font-family: 'Playfair Display', serif;
  color: white;
}

/* Glass Panel */
.glass-panel {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 20px;
  overflow: hidden;
}

.cart-items {
  margin-bottom: 30px;
}

.cart-item {
  display: grid;
  grid-template-columns: 100px 1fr 180px 150px 80px;
  gap: 20px;
  padding: 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  align-items: center;
  transition: background 0.3s ease;
}

.cart-item:hover {
  background: rgba(255, 255, 255, 0.03);
}

.cart-item:last-child {
  border-bottom: none;
}

.cart-item__image img {
  width: 100%;
  height: auto;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.cart-item__title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 5px;
  color: white;
}

.cart-item__title a {
  color: white;
  text-decoration: none;
  transition: color 0.3s ease;
}

.cart-item__title a:hover {
  color: #00F2FF;
}

.cart-item__variant {
  color: rgba(255, 255, 255, 0.6);
  font-size: 14px;
}

.cart-item__urgency {
  margin-top: 8px;
}

.urgency-badge {
  display: inline-block;
  padding: 4px 10px;
  background: rgba(255, 107, 107, 0.2);
  border: 1px solid rgba(255, 107, 107, 0.4);
  border-radius: 50px;
  font-size: 12px;
  font-weight: 600;
  color: #FF6B6B;
}

/* Quantity Controls */
.cart-item__quantity label {
  display: block;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8px;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 0;
}

.quantity-btn {
  width: 40px;
  height: 40px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: white;
  font-size: 18px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.quantity-minus {
  border-radius: 8px 0 0 8px;
  border-right: none;
}

.quantity-plus {
  border-radius: 0 8px 8px 0;
  border-left: none;
}

.quantity-btn:hover {
  background: rgba(0, 242, 255, 0.2);
  border-color: rgba(0, 242, 255, 0.4);
}

.cart-item__quantity input {
  width: 60px;
  padding: 10px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 0;
  text-align: center;
  font-size: 16px;
  background: rgba(255, 255, 255, 0.05);
  color: white;
}

.cart-item__price {
  font-size: 18px;
  font-weight: 600;
  text-align: right;
  color: white;
}

.cart-item__price--sale {
  background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
}

.cart-item__price--compare {
  text-decoration: line-through;
  color: rgba(255, 255, 255, 0.4);
  font-size: 14px;
  display: block;
}

.cart-item__savings {
  display: block;
  font-size: 12px;
  color: #10b981;
  margin-top: 4px;
}

.cart-item__remove-link {
  color: rgba(255, 255, 255, 0.5);
  text-decoration: none;
  font-size: 13px;
  transition: color 0.3s ease;
}

.cart-item__remove-link:hover {
  color: #FF6B6B;
}

/* Cart Note */
.cart-note {
  margin-bottom: 30px;
  padding: 24px;
}

.cart-note label {
  display: block;
  font-weight: 600;
  margin-bottom: 10px;
  color: white;
}

.cart-note__textarea {
  width: 100%;
  padding: 16px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  font-size: 14px;
  font-family: inherit;
  resize: vertical;
  min-height: 100px;
  background: rgba(255, 255, 255, 0.05);
  color: white;
  transition: border-color 0.3s ease, box-shadow 0.3s ease;
}

.cart-note__textarea:focus {
  outline: none;
  border-color: rgba(0, 242, 255, 0.5);
  box-shadow: 0 0 20px rgba(0, 242, 255, 0.2);
}

.cart-note__textarea::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

/* Cart Footer */
.cart-footer {
  padding: 32px;
}

/* Free Shipping Progress */
.free-shipping-progress {
  margin-bottom: 24px;
  padding: 20px;
  background: rgba(0, 242, 255, 0.05);
  border: 1px solid rgba(0, 242, 255, 0.2);
  border-radius: 16px;
}

.shipping-progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  color: white;
  font-size: 14px;
}

.shipping-remaining {
  background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  font-weight: 700;
}

.shipping-progress-bar {
  position: relative;
  height: 10px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50px;
  overflow: hidden;
}

.shipping-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #00F2FF, #BD00FF);
  border-radius: 50px;
  transition: width 0.5s ease;
  position: relative;
}

.shipping-progress-glow {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: shimmer-slide 2s ease-in-out infinite;
}

@keyframes shimmer-slide {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.shipping-success {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 16px;
  background: rgba(16, 185, 129, 0.2);
  border: 1px solid rgba(16, 185, 129, 0.4);
  border-radius: 12px;
  color: #10b981;
  font-weight: 600;
  animation: success-glow 2s ease-in-out infinite;
}

@keyframes success-glow {
  0%, 100% { box-shadow: 0 0 20px rgba(16, 185, 129, 0.2); }
  50% { box-shadow: 0 0 40px rgba(16, 185, 129, 0.4); }
}

.success-icon {
  font-size: 24px;
}

.cart-subtotal {
  display: flex;
  justify-content: space-between;
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  color: white;
}

.cart-subtotal__price {
  background: linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

/* Trust Badges Mini */
.cart-trust-badges {
  display: flex;
  justify-content: center;
  gap: 24px;
  margin-bottom: 24px;
  padding-bottom: 24px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.trust-mini-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  color: rgba(255, 255, 255, 0.7);
  font-size: 13px;
  font-weight: 500;
}

.trust-mini-badge span:first-child {
  font-size: 16px;
}

/* Cart Actions */
.cart-actions {
  display: flex;
  gap: 16px;
  margin-bottom: 24px;
}

.cart-actions button {
  flex: 1;
}

.btn-secondary-arctic {
  padding: 16px 24px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 50px;
  color: white;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.btn-secondary-arctic:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(0, 242, 255, 0.4);
}

.checkout-btn {
  display: flex !important;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 56px;
}

.btn-icon {
  font-size: 18px;
}

.cart-continue-shopping {
  display: block;
  text-align: center;
  color: rgba(255, 255, 255, 0.7);
  text-decoration: none;
  font-weight: 500;
  transition: color 0.3s ease;
}

.cart-continue-shopping:hover {
  color: #00F2FF;
}

/* Empty Cart */
.cart-empty {
  text-align: center;
  padding: 80px 40px;
}

.cart-empty .empty-icon {
  font-size: 64px;
  margin-bottom: 24px;
  opacity: 0.5;
}

.cart-empty p {
  font-size: 24px;
  color: white;
  margin-bottom: 12px;
}

.cart-empty .empty-subtext {
  font-size: 16px;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 32px;
}

/* Responsive */
@media (max-width: 1024px) {
  .cart-item {
    grid-template-columns: 80px 1fr 150px auto;
    gap: 16px;
  }
  
  .cart-item__remove {
    grid-column: span 4;
    text-align: right;
  }
}

@media (max-width: 768px) {
  .arctic-cart {
    padding: 40px 16px;
  }

  .cart-urgency-banner {
    flex-wrap: wrap;
    text-align: center;
    padding: 12px 16px;
  }

  .urgency-text {
    font-size: 13px;
    width: 100%;
    order: 2;
    margin-top: 8px;
  }

  .cart-item {
    grid-template-columns: 1fr;
    gap: 16px;
    padding: 20px;
  }
  
  .cart-item__image {
    max-width: 120px;
    margin: 0 auto;
  }
  
  .cart-item__details {
    text-align: center;
  }
  
  .cart-item__quantity {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cart-item__price {
    text-align: center;
  }

  .cart-item__remove {
    text-align: center;
  }
  
  .cart-actions {
    flex-direction: column;
  }

  .cart-trust-badges {
    flex-wrap: wrap;
    gap: 16px;
  }

  .cart-footer {
    padding: 24px 20px;
  }

  .cart-subtotal {
    font-size: 20px;
  }
}

@media (max-width: 480px) {
  .trust-mini-badge span:last-child {
    display: none;
  }
  
  .trust-mini-badge {
    padding: 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
  }
  
  .trust-mini-badge span:first-child {
    font-size: 20px;
  }
}
</style>

<script>
// Cart urgency timer countdown
(function() {
  const timerElement = document.getElementById('cart-urgency-timer');
  if (!timerElement) return;
  
  let minutes = 15;
  let seconds = 0;
  
  setInterval(function() {
    if (seconds === 0) {
      if (minutes === 0) {
        minutes = 15;
        seconds = 0;
      } else {
        minutes--;
        seconds = 59;
      }
    } else {
      seconds--;
    }
    
    timerElement.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
  }, 1000);
})();

// Simulate viewer count changes
(function() {
  const viewerCount = document.getElementById('cart-viewer-count');
  if (!viewerCount) return;
  
  setInterval(function() {
    const currentCount = parseInt(viewerCount.textContent);
    const change = Math.random() > 0.5 ? 1 : -1;
    const newCount = Math.max(5, Math.min(50, currentCount + change));
    viewerCount.textContent = newCount;
  }, 8000);
})();
</script>
