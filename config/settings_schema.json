[
  {
    "name": "theme_info",
    "theme_name": "SeasonTrend Arctic Neo-Luxury",
    "theme_version": "2.0.0",
    "theme_author": "SeasonTrend Team",
    "theme_documentation_url": "https://github.com/noor-87dsdp-beep/seasontrend.us",
    "theme_support_url": "https://seasontrend.us/support"
  },
  {
    "name": "Analytics & Tracking",
    "settings": [
      {
        "type": "header",
        "content": "Google Analytics 4"
      },
      {
        "type": "text",
        "id": "google_analytics_id",
        "label": "Google Analytics Measurement ID",
        "info": "Enter your GA4 Measurement ID (e.g., G-XXXXXXXXXX)"
      },
      {
        "type": "header",
        "content": "Meta Pixel (Facebook)"
      },
      {
        "type": "text",
        "id": "facebook_pixel_id",
        "label": "Meta Pixel ID",
        "info": "Enter your Facebook Pixel ID"
      },
      {
        "type": "header",
        "content": "TikTok Pixel"
      },
      {
        "type": "text",
        "id": "tiktok_pixel_id",
        "label": "TikTok Pixel ID",
        "info": "Enter your TikTok Pixel ID"
      },
      {
        "type": "header",
        "content": "Pinterest Tag"
      },
      {
        "type": "text",
        "id": "pinterest_tag_id",
        "label": "Pinterest Tag ID",
        "info": "Enter your Pinterest Tag ID"
      },
      {
        "type": "header",
        "content": "Snapchat Pixel"
      },
      {
        "type": "text",
        "id": "snapchat_pixel_id",
        "label": "Snapchat Pixel ID",
        "info": "Enter your Snapchat Pixel ID"
      },
      {
        "type": "header",
        "content": "Hotjar Analytics"
      },
      {
        "type": "text",
        "id": "hotjar_id",
        "label": "Hotjar Site ID",
        "info": "Enter your Hotjar Site ID"
      },
      {
        "type": "header",
        "content": "Microsoft Clarity"
      },
      {
        "type": "text",
        "id": "clarity_id",
        "label": "Microsoft Clarity Project ID",
        "info": "Enter your Microsoft Clarity Project ID"
      }
    ]
  },
  {
    "name": "Cart Settings",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_notes_enable",
        "label": "Enable cart notes",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold",
        "info": "Amount in cents (e.g., 5000 for $50). Set to 0 to disable.",
        "default": 5000
      }
    ]
  },
  {
    "name": "Product Settings",
    "settings": [
      {
        "type": "checkbox",
        "id": "product_show_vendor",
        "label": "Show product vendor",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_show_sku",
        "label": "Show product SKU",
        "default": false
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "info": "https://facebook.com/yourpage"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "info": "https://instagram.com/yourpage"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter/X",
        "info": "https://twitter.com/yourpage"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "TikTok",
        "info": "https://tiktok.com/@yourpage"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube",
        "info": "https://youtube.com/yourpage"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "info": "https://pinterest.com/yourpage"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_max_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 150
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "32x32 pixels recommended"
      }
    ]
  }
]
