<!-- Footer -->
<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-column">
        <h3 class="footer-logo">Season<span>Trend</span></h3>
        <p class="footer-description">
          {{ section.settings.description | default: "Your trusted destination for trending seasonal products. Quality, style, and service guaranteed." }}
        </p>
        <div class="footer-social">
          {% if section.settings.facebook_url %}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">📘</a>
          {% endif %}
          {% if section.settings.instagram_url %}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">📷</a>
          {% endif %}
          {% if section.settings.twitter_url %}
            <a href="{{ section.settings.twitter_url }}" target="_blank" rel="noopener" aria-label="Twitter">🐦</a>
          {% endif %}
          {% if section.settings.pinterest_url %}
            <a href="{{ section.settings.pinterest_url }}" target="_blank" rel="noopener" aria-label="Pinterest">📌</a>
          {% endif %}
        </div>
      </div>

      {% for block in section.blocks %}
        {% if block.type == 'menu' %}
          <div class="footer-column" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.title }}</h4>
            {% if block.settings.menu != blank %}
              <ul class="footer-links">
                {% for link in linklists[block.settings.menu].links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}

      <div class="footer-column">
        <h4>Contact Us</h4>
        <ul class="footer-contact">
          {% if section.settings.email %}
            <li>📧 {{ section.settings.email }}</li>
          {% endif %}
          {% if section.settings.phone %}
            <li>📞 {{ section.settings.phone }}</li>
          {% endif %}
          {% if section.settings.address %}
            <li>📍 {{ section.settings.address }}</li>
          {% endif %}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-payment">
        <span>We Accept:</span>
        <div class="payment-icons">
          <span>💳</span>
          <span>💳</span>
          <span>💳</span>
          <span>💳</span>
        </div>
      </div>
      <div class="footer-copyright">
        <p>© {{ 'now' | date: "%Y" }} {{ shop.name }}. {{ section.settings.copyright_text | default: "All rights reserved." }}</p>
      </div>
      <div class="footer-legal">
        {% if section.settings.show_legal_links %}
          <a href="/pages/privacy-policy">Privacy Policy</a>
          <a href="/pages/terms-of-service">Terms of Service</a>
          <a href="/pages/refund-policy">Refund Policy</a>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Footer Description",
      "default": "Your trusted destination for trending seasonal products. Quality, style, and service guaranteed."
    },
    {
      "type": "header",
      "content": "Social Media"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "Twitter URL"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest URL"
    },
    {
      "type": "header",
      "content": "Contact Information"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "header",
      "content": "Legal"
    },
    {
      "type": "checkbox",
      "id": "show_legal_links",
      "label": "Show Legal Links",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
