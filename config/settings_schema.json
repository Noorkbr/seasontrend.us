[
  {
    "name": "theme_info",
    "theme_name": "SeasonTrend",
    "theme_version": "1.0.0",
    "theme_author": "SeasonTrend Team",
    "theme_documentation_url": "https://seasontrend.us/docs",
    "theme_support_url": "https://seasontrend.us/support"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Color Scheme"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Color",
        "default": "#6366f1"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary Color",
        "default": "#8b5cf6"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent Color",
        "default": "#ec4899"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text Color",
        "default": "#1f2937"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background Color",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "select",
        "id": "heading_font",
        "label": "Heading Font",
        "options": [
          {
            "value": "Playfair Display",
            "label": "Playfair Display"
          },
          {
            "value": "Georgia",
            "label": "Georgia"
          },
          {
            "value": "Times New Roman",
            "label": "Times New Roman"
          }
        ],
        "default": "Playfair Display"
      },
      {
        "type": "select",
        "id": "body_font",
        "label": "Body Font",
        "options": [
          {
            "value": "Inter",
            "label": "Inter"
          },
          {
            "value": "Arial",
            "label": "Arial"
          },
          {
            "value": "Helvetica",
            "label": "Helvetica"
          }
        ],
        "default": "Inter"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "header",
        "content": "Logo Settings"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo Width",
        "default": 150
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "header",
        "content": "Social Media Links"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "Twitter URL"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest URL"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "header",
        "content": "Shopping Cart"
      },
      {
        "type": "checkbox",
        "id": "cart_notes_enable",
        "label": "Enable cart notes",
        "default": true
      },
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      }
    ]
  },
  {
    "name": "Product",
    "settings": [
      {
        "type": "header",
        "content": "Product Page"
      },
      {
        "type": "checkbox",
        "id": "product_show_vendor",
        "label": "Show product vendor",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "product_show_sku",
        "label": "Show product SKU",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "product_enable_zoom",
        "label": "Enable image zoom",
        "default": true
      }
    ]
  }
]
