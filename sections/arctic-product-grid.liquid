{% comment %}
  Arctic Product Grid Section
  ============================
  Dynamic product grid with AJAX add-to-cart functionality.
  
  MERCHANT CUSTOMIZATION (via Shopify Theme Editor):
  - Select a collection OR manually pick products
  - Customize title, subtitle, button text
  - Control number of products displayed (4-24)
  - Enable/disable badges and sale tags
  
  To edit: Theme Editor > Home page > Arctic Product Grid
{% endcomment %}

<section class="product-grid-section" id="holographic-grid">
  <div class="container">
    {% if section.settings.grid_title %}
      <div class="arctic-section-header">
        <h2 class="arctic-section-title">
          {{ section.settings.grid_title }}
        </h2>
        {% if section.settings.grid_subtitle %}
          <p class="arctic-section-subtitle">{{ section.settings.grid_subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}
    
    <div class="holographic-grid" data-products-grid>
      {%- comment -%} Priority: Manual product list > Collection > All products fallback {%- endcomment -%}
      {% if section.settings.product_list != blank %}
        {% assign products = section.settings.product_list %}
      {% elsif section.settings.collection != blank %}
        {% assign products = section.settings.collection.products %}
      {% else %}
        {% assign products = collections.all.products %}
      {% endif %}
      
      {% if products.size > 0 %}
        {% for product in products limit: section.settings.products_to_show %}
          <article class="glass-product-card" data-product-card data-product-id="{{ product.id }}">
            {%- comment -%} Sale badge {%- endcomment -%}
            {% if section.settings.show_badges and product.compare_at_price > product.price %}
              <div class="product-badge product-badge--sale">
                {% assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                -{{ savings }}%
              </div>
            {% endif %}
            
            <div class="product-image-container">
              <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {% if product.featured_image %}
                  <img 
                    src="{{ product.featured_image | image_url: width: 400 }}"
                    srcset="{{ product.featured_image | image_url: width: 200 }} 200w,
                            {{ product.featured_image | image_url: width: 400 }} 400w,
                            {{ product.featured_image | image_url: width: 600 }} 600w"
                    sizes="(max-width: 480px) 45vw, (max-width: 768px) 30vw, (max-width: 1200px) 25vw, 300px"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                    class="product-image">
                  {% if product.images.size > 1 and section.settings.show_secondary_image %}
                    <img 
                      src="{{ product.images[1] | image_url: width: 400 }}"
                      alt="{{ product.images[1].alt | default: product.title | escape }}"
                      width="400"
                      height="400"
                      loading="lazy"
                      decoding="async"
                      class="product-image product-image--hover">
                  {% endif %}
                {% else %}
                  <div class="product-image-placeholder">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="M21 15l-5-5L5 21"/>
                    </svg>
                  </div>
                {% endif %}
              </a>
            </div>
            
            <div class="product-info">
              <h3 class="product-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              
              <div class="product-price">
                <span class="product-price__current">{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <span class="product-price__compare">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </div>
              
              {% if product.available %}
                <form class="product-form" data-add-to-cart-form>
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button 
                    type="submit" 
                    class="quick-buy-btn"
                    data-add-to-cart
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                    aria-label="{{ 'products.product.add_to_cart' | t }}: {{ product.title | escape }}">
                    <span class="btn-text">{{ section.settings.add_to_cart_text | default: 'Add to Cart' }}</span>
                    <span class="btn-loading" aria-hidden="true">
                      <svg class="spinner" viewBox="0 0 24 24" width="20" height="20">
                        <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="32" stroke-linecap="round"/>
                      </svg>
                    </span>
                    <span class="btn-success" aria-hidden="true">✓</span>
                  </button>
                </form>
              {% else %}
                <button class="quick-buy-btn quick-buy-btn--sold-out" disabled aria-disabled="true">
                  {{ 'products.product.sold_out' | t | default: 'Sold Out' }}
                </button>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      {% else %}
        {%- comment -%} Placeholder cards when no products {%- endcomment -%}
        {% for i in (1..4) %}
          <article class="glass-product-card glass-product-card--placeholder">
            <div class="product-image-container">
              <div class="product-image-placeholder">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <path d="M21 15l-5-5L5 21"/>
                </svg>
              </div>
            </div>
            <div class="product-info">
              <h3 class="product-title"><a href="#">Sample Product {{ i }}</a></h3>
              <div class="product-price"><span class="product-price__current">$99.00</span></div>
              <button class="quick-buy-btn" disabled>Add to Cart</button>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
    
    {% if section.settings.view_all_link %}
      <div class="arctic-section-footer">
        <a href="{{ section.settings.view_all_link }}" class="glass-pill-btn">
          {{ section.settings.view_all_text | default: "View All Products" }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
/* Arctic Section Header */
.arctic-section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.arctic-section-title {
  font-family: var(--font-clash, 'Inter', sans-serif);
  font-size: clamp(2rem, 6vw, 4rem);
  font-weight: 800;
  color: white;
  margin: 0 0 1rem;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.arctic-section-subtitle {
  font-family: var(--font-satoshi, 'Inter', sans-serif);
  font-size: 1.125rem;
  color: rgba(255, 255, 255, 0.7);
  margin: 0;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.arctic-section-footer {
  text-align: center;
  margin-top: 3rem;
}

/* Product Badge */
.product-badge {
  position: absolute;
  top: 1rem;
  left: 1rem;
  z-index: 10;
  padding: 0.375rem 0.75rem;
  border-radius: 50px;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.product-badge--sale {
  background: linear-gradient(135deg, #FF6B6B, #FF8787);
  color: white;
}

/* Product Info Container */
.product-info {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

/* Product Price Improvements */
.product-price__current {
  font-family: var(--font-satoshi, 'Inter', sans-serif);
  font-size: 1.25rem;
  font-weight: 700;
  background: var(--gradient-aurora, linear-gradient(135deg, #00F2FF 0%, #BD00FF 100%));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.product-price__compare {
  font-size: 0.95rem;
  text-decoration: line-through;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 0.5rem;
  -webkit-text-fill-color: initial;
  background: none;
}

/* Image Hover Effect */
.product-image-container {
  position: relative;
  overflow: hidden;
}

.product-image {
  transition: opacity 0.4s ease, transform 0.6s ease;
}

.product-image--hover {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}

.glass-product-card:hover .product-image--hover {
  opacity: 1;
}

.glass-product-card:hover .product-image:not(.product-image--hover) {
  opacity: 0;
}

/* Image Placeholder */
.product-image-placeholder {
  width: 100%;
  height: 100%;
  min-height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(0, 242, 255, 0.1) 0%, rgba(189, 0, 255, 0.1) 100%);
  color: rgba(255, 255, 255, 0.3);
}

/* Button States */
.quick-buy-btn {
  position: relative;
  overflow: hidden;
}

.quick-buy-btn .btn-loading,
.quick-buy-btn .btn-success {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  opacity: 0;
  pointer-events: none;
}

.quick-buy-btn.is-loading .btn-text { opacity: 0; }
.quick-buy-btn.is-loading .btn-loading { opacity: 1; }
.quick-buy-btn.is-success .btn-text { opacity: 0; }
.quick-buy-btn.is-success .btn-success { opacity: 1; }

.quick-buy-btn .spinner {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.quick-buy-btn--sold-out {
  background: rgba(255, 255, 255, 0.1) !important;
  cursor: not-allowed;
  opacity: 0.6;
}

/* Product Form */
.product-form {
  margin: 0;
}

/* Mobile Optimizations */
@media (max-width: 768px) {
  .arctic-section-header {
    margin-bottom: 2rem;
    text-align: left;
    padding: 0 0.5rem;
  }
  
  .arctic-section-subtitle {
    margin-left: 0;
    font-size: 1rem;
  }
  
  .product-badge {
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.625rem;
  }
  
  .product-price__current {
    font-size: 1.1rem;
  }
  
  .product-price__compare {
    font-size: 0.85rem;
  }
  
  /* Ensure buttons are always visible on mobile */
  .quick-buy-btn {
    min-height: 48px;
    font-size: 0.875rem;
  }
}
</style>

{% schema %}
{
  "name": "Arctic Product Grid",
  "tag": "section",
  "class": "arctic-product-grid-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Content",
      "info": "Customize the section title and description"
    },
    {
      "type": "text",
      "id": "grid_title",
      "label": "Section Title",
      "default": "Featured Products",
      "info": "Main heading for this section"
    },
    {
      "type": "textarea",
      "id": "grid_subtitle",
      "label": "Section Subtitle",
      "info": "Optional description text below the title"
    },
    {
      "type": "header",
      "content": "Product Source",
      "info": "Choose how products are displayed"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection",
      "info": "Products will be pulled from this collection"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Or: Manual Product Selection",
      "info": "Overrides collection selection. Pick specific products to display.",
      "limit": 24
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of Products",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 8,
      "info": "How many products to display"
    },
    {
      "type": "header",
      "content": "Product Display Options"
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show Sale Badges",
      "default": true,
      "info": "Display discount percentage on sale items"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show Second Image on Hover",
      "default": true,
      "info": "Displays alternate product image when hovering"
    },
    {
      "type": "text",
      "id": "add_to_cart_text",
      "label": "Add to Cart Button Text",
      "default": "Add to Cart"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Button Text",
      "default": "View All Products"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Button Link",
      "info": "Link to collection or page"
    }
  ],
  "presets": [
    {
      "name": "Arctic Product Grid",
      "category": "Arctic Neo-Luxury",
      "settings": {
        "grid_title": "Trending Now",
        "products_to_show": 8,
        "show_badges": true,
        "view_all_text": "View All Products"
      }
    }
  ]
}
{% endschema %}