<!-- Categories Section -->
<section class="categories" id="categories">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.title | default: "Shop by Category" }}</h2>
      <p class="section-subtitle">{{ section.settings.subtitle | default: "Browse our curated collections" }}</p>
    </div>
    <div class="categories-grid">
      {% for block in section.blocks %}
        {% if block.type == 'category' %}
          <div class="category-card" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '/collections/all' }}">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | img_url: 'medium' }}" alt="{{ block.settings.title }}" loading="lazy">
              {% else %}
                <div class="category-placeholder" style="background: {{ block.settings.gradient | default: 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)' }};">
                  <span class="category-icon">{{ block.settings.icon | default: "🛍️" }}</span>
                </div>
              {% endif %}
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.count | default: 0 }} items</p>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Categories",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Category"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Browse our curated collections"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Category Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🛍️"
        },
        {
          "type": "text",
          "id": "gradient",
          "label": "Background Gradient (if no image)",
          "default": "linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
        },
        {
          "type": "text",
          "id": "count",
          "label": "Item Count"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Electronics",
            "icon": "📱",
            "gradient": "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
            "count": "150"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Fashion",
            "icon": "👕",
            "gradient": "linear-gradient(135deg, #f093fb 0%, #f5576c 100%)",
            "count": "320"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Home & Living",
            "icon": "🏠",
            "gradient": "linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)",
            "count": "200"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Beauty",
            "icon": "💄",
            "gradient": "linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)",
            "count": "180"
          }
        }
      ]
    }
  ]
}
{% endschema %}
