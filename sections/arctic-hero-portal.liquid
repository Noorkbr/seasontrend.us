{% comment %}
  Arctic Hero Portal Section
  ==========================
  Immersive hero with particle effects, parallax layers, and floating product.
  
  MERCHANT CUSTOMIZATION (via Shopify Theme Editor):
  - Edit headline and subheadline text
  - Upload featured product image (with 3D rotation effect)
  - Customize CTA button text and link
  - All animations handled automatically
  
  To edit: Theme Editor > Home page > Arctic Hero Portal
{% endcomment %}

<!-- SECTION 1: Arctic Neo-Luxury Portal Hero -->
<section class="hero-portal" id="arctic-hero">
  <!-- Particle Canvas for 3D Neon Snowflakes -->
  <canvas id="particle-canvas" aria-hidden="true"></canvas>
  
  <!-- Parallax Aurora Layers -->
  <div class="parallax-layer layer-1" aria-hidden="true"></div>
  <div class="parallax-layer layer-2" aria-hidden="true"></div>
  
  <!-- Floating Product (3D Rotation with Mouse) -->
  <div class="product-float float-soft" aria-hidden="true">
    {% if section.settings.hero_product_image %}
      <img 
        src="{{ section.settings.hero_product_image | image_url: width: 800 }}"
        srcset="{{ section.settings.hero_product_image | image_url: width: 400 }} 400w,
                {{ section.settings.hero_product_image | image_url: width: 600 }} 600w,
                {{ section.settings.hero_product_image | image_url: width: 800 }} 800w"
        sizes="(max-width: 480px) 200px, (max-width: 768px) 300px, 500px"
        alt="{{ section.settings.hero_product_title | default: 'Featured Product' | escape }}"
        width="800"
        height="800"
        loading="eager"
        fetchpriority="high"
        decoding="async">
    {% else %}
      <!-- Placeholder gradient sphere -->
      <div class="hero-product-placeholder"></div>
    {% endif %}
  </div>
  
  <!-- Hero Content -->
  <div class="hero-content">
    <h1 class="liquid-headline">
      {{ section.settings.hero_headline | default: "FUTURE. COMFORT." }}
    </h1>
    
    {% if section.settings.hero_subheadline %}
      <p class="hero-subheadline">
        {{ section.settings.hero_subheadline }}
      </p>
    {% endif %}
    
    {% if section.settings.hero_cta_text %}
      <a href="{{ section.settings.hero_cta_link | default: '/collections/all' }}" class="glass-pill-btn" id="heroCTA">
        {{ section.settings.hero_cta_text | default: "Enter The Future" }}
      </a>
    {% endif %}
  </div>
</section>

<style>
/* Hero Subheadline */
.hero-subheadline {
  font-family: var(--font-satoshi, 'Inter', sans-serif);
  font-size: clamp(1rem, 3vw, 1.25rem);
  color: rgba(255, 255, 255, 0.7);
  margin-bottom: 2rem;
  letter-spacing: 0.05em;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

/* Product Placeholder */
.hero-product-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(0, 242, 255, 0.3) 0%, rgba(189, 0, 255, 0.3) 100%);
  filter: blur(30px);
  animation: pulse-glow 4s ease-in-out infinite;
}

@keyframes pulse-glow {
  0%, 100% { 
    opacity: 0.5;
    transform: scale(0.95);
  }
  50% { 
    opacity: 0.8;
    transform: scale(1);
  }
}

/* Ensure hero CTA is a link */
a.glass-pill-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
</style>

{% schema %}
{
  "name": "Arctic Hero Portal",
  "settings": [
    {
      "type": "header",
      "content": "Hero Content"
    },
    {
      "type": "text",
      "id": "hero_headline",
      "label": "Headline",
      "default": "FUTURE. COMFORT.",
      "info": "Main headline with liquid metal effect"
    },
    {
      "type": "textarea",
      "id": "hero_subheadline",
      "label": "Subheadline",
      "info": "Optional supporting text"
    },
    {
      "type": "text",
      "id": "hero_cta_text",
      "label": "CTA Button Text",
      "default": "Enter The Future"
    },
    {
      "type": "url",
      "id": "hero_cta_link",
      "label": "CTA Button Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Featured Product"
    },
    {
      "type": "image_picker",
      "id": "hero_product_image",
      "label": "Product Image",
      "info": "Product to float in the center with 3D rotation"
    },
    {
      "type": "text",
      "id": "hero_product_title",
      "label": "Product Title",
      "info": "For accessibility"
    }
  ],
  "presets": [
    {
      "name": "Arctic Hero Portal",
      "category": "Arctic Neo-Luxury"
    }
  ]
}
{% endschema %}
